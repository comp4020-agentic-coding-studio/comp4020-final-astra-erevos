---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { marked } from "marked";

// README.md is the argued definition of good (see the final-project brief);
// this page is required to publish it in full at /readme/. Read from cwd,
// not import.meta.url, so this resolves the same way in dev and once built.
const readmeMarkdown = readFileSync(join(process.cwd(), "README.md"), "utf8");
const readmeHtml = marked.parse(readmeMarkdown) as string;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Toad Live — README</title>
    <style>
      :root {
        color-scheme: light;
        --page: #f6efe1;
        --ink: #2c2115;
        --ink-secondary: #6b5c47;
        --border: rgba(44, 33, 21, 0.14);
        --accent: #3f6b3f;
        --accent-strong: #2f5233;
        --surface-alt: #fdf6e6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --page: #1c150f;
          --ink: #f6ecd9;
          --ink-secondary: #d3c2a3;
          --border: rgba(246, 236, 217, 0.16);
          --accent: #86b986;
          --accent-strong: #a6d1a6;
          --surface-alt: #241b12;
        }
      }
      body {
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
        max-width: 40rem;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        background: var(--page);
        color: var(--ink);
      }
      h1, h2, h3 { color: var(--accent-strong); }
      a { color: var(--accent); }
      code {
        background: var(--surface-alt);
        border: 1px solid var(--border);
        padding: 0.1em 0.3em;
        border-radius: 4px;
      }
      hr { border: none; border-top: 1px solid var(--border); }
    </style>
  </head>
  <body>
    <p><a href="/">← back to the laundry board</a></p>
    <article set:html={readmeHtml} />
  </body>
</html>
