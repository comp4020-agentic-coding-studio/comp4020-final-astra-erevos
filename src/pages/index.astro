    <script>
      // Stage 2.3: the 3D hall view's only hook into live updates — see
      // scene.ts's own note on why importing this here, from a second,
      // separate inline script block, still reaches the same module
      // instance mount() runs in (ES modules are singletons keyed by
      // URL; both scripts import the same file).
      import { applyMachineToScene } from "../lib/hall-view/scene.ts";
      import type { Machine } from "../lib/types.ts";
      // Stage 3 (AA Room): the page's one SSE connection now lives in its
      // own shared module (src/lib/live-stream.ts) rather than as a local
      // `const events` here, specifically so the separate AA Room script
      // block further down can observe `aa-room` events on the exact same
      // connection instead of opening a second EventSource. See that
      // module's own note on why — same "ES modules are singletons keyed
      // by URL" sharing scene.ts already relies on.
      import { onMachineEvent, onOpen } from "../lib/live-stream.ts";

      // Server-rendered badge text/icon/class (STATUS_META in the
      // frontmatter above), read once rather than re-derived here, so a
      // live update can never drift from what a fresh page load would show.
      const STATUS_META = JSON.parse(document.body.dataset.statusMeta!) as Record<
        string,
        { label: string; icon: string; class: string }
      >;

      // The server's actual GET/PATCH/SSE payloads are the full Machine
      // shape (src/lib/types.ts) — this was previously its own narrower
      // local interface (id/status/expectedEndAt/confirmedAt/version
      // only, with status typed as a loose string) that happened to
      // cover what the dashboard card needed. Widened to the real
      // Machine type so the exact same payload can also be handed to
      // applyMachineToScene() below without a cast or a second parse.
      type MachineUpdate = Machine;

      // Mirrors confirmedLabel()/remainingLabel() in the frontmatter above.
      // Both need the *client's* current clock, so they can't be shared
      // directly across the server/client boundary — kept tiny and
      // behaviourally identical instead of invented differently here.
      function confirmedLabel(confirmedAt: number | null): string {
        if (confirmedAt === null) return "never reported";
        const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
        if (minutes < 1) return "confirmed just now";
        return `confirmed ${minutes} min ago`;
      }

      function remainingLabel(expectedEndAt: number | null): { text: string; known: boolean } {
        if (expectedEndAt === null) return { text: "remaining time unknown", known: false };
        const minutes = Math.round((expectedEndAt - Date.now()) / 60_000);
        return minutes > 0
          ? { text: `${minutes} min left`, known: true }
          : { text: "should be finishing", known: true };
      }

      // One status per visible machine, kept in sync with every incoming
      // update so the summary row never needs a full-page recount.
      const statusByMachine = new Map<string, string>(
        Array.from(document.querySelectorAll<HTMLElement>(".machine")).map((el) => [
          el.dataset.machine!,
          el.dataset.status!,
        ]),
      );

      function updateSummary(): void {
        const counts: Record<string, number> = { available: 0, "in-use": 0, "out-of-order": 0, unknown: 0 };
        for (const status of statusByMachine.values()) counts[status] = (counts[status] ?? 0) + 1;
        for (const [key, count] of Object.entries(counts)) {
          const el = document.querySelector(`.stat.${key} .value`);
          if (el) el.textContent = String(count);
        }
      }

      // Applies one machine's canonical state to its card — used for a
      // live push, for the current state a 409 conflict hands back, and
      // for the re-fetch a (re)connected EventSource triggers below. Never
      // reloads the page: this *is* "without a reload."
      //
      // Stage 2.3: also the Hall View's only subscriber to this same
      // canonical path (see applyMachineToScene's own note in scene.ts).
      // Called unconditionally, before the dashboard-card early return
      // below, since it's an orthogonal concern: applyMachineToScene()
      // already no-ops for any machine id it has no mesh for (today,
      // anything outside the A/B room), the same way this function's
      // own card lookup no-ops for an id it finds no card for.
      function applyMachineUpdate(machine: MachineUpdate): void {
        applyMachineToScene(machine);

        const card = document.querySelector<HTMLElement>(`.machine[data-machine="${machine.id}"]`);
        if (!card) return;

        card.dataset.status = machine.status;
        card.classList.toggle("machine--broken", machine.status === "out-of-order");

        const meta = STATUS_META[machine.status];
        const badge = card.querySelector(".badge");
        if (badge && meta) {
          badge.className = `badge ${meta.class}`;
          badge.innerHTML = `<span aria-hidden="true">${meta.icon}</span>${meta.label}`;
        }

        const remainingEl = card.querySelector<HTMLElement>(".remaining");
        if (remainingEl) {
          if (machine.status === "in-use") {
            const remaining = remainingLabel(machine.expectedEndAt);
            remainingEl.hidden = false;
            remainingEl.classList.toggle("unknown-time", !remaining.known);
            remainingEl.textContent = remaining.text;
          } else {
            remainingEl.hidden = true;
          }
        }

        const confirmedEl = card.querySelector(".confirmed");
        if (confirmedEl) confirmedEl.textContent = confirmedLabel(machine.confirmedAt);

        // The next PATCH from this card must match the version it just
        // saw, not the one the page was originally rendered with.
        const form = card.querySelector<HTMLFormElement>(".report-form");
        if (form) form.dataset.version = String(machine.version);

        statusByMachine.set(machine.id, machine.status);
        updateSummary();
      }

      // The page's one SSE connection (src/lib/live-stream.ts). No event
      // replay/history: a (re)connection just re-fetches current state
      // for every card below, the same read path any page load already
      // uses — see notes/adr/0001-realtime-and-concurrent-updates.md.
      onMachineEvent((machine) => {
        applyMachineUpdate(machine);
      });

      onOpen(() => {
        const ids = Array.from(document.querySelectorAll<HTMLElement>(".machine")).map(
          (el) => el.dataset.machine!,
        );
        Promise.all(
          ids.map((id) => fetch(`/api/machines/${id}`).then((res) => res.json() as Promise<MachineUpdate>)),
        ).then((machines) => machines.forEach(applyMachineUpdate));
      });

      // Scoped to `.machines .report-form`, not a bare `.report-form` —
      // AA Room's own report form (src/pages/index.astro's AA Room
      // section) shares the `report-form` class purely for its CSS
      // styling (form.report-form's shared visual treatment, further
      // down in this file's <style>), but it is NOT a machine form and
      // has no `status`/`minutes` fields. A real-browser check caught
      // this directly: the unscoped selector below used to also match
      // AA Room's form, attaching this Machine-specific submit handler
      // to it too — every AA Room report then threw
      // "Cannot read properties of null (reading 'value')" from
      // form.elements.namedItem("status") finding nothing, a real
      // uncaught exception on every AA Room submission (silent in effect
      // only because AA Room's own, separate handler still ran and
      // completed independently — addEventListener listeners don't
      // short-circuit each other). `.machines` is the Laundry-only
      // wrapper around each block's machine cards; the AA Room form is
      // never inside it.
      document.querySelectorAll<HTMLFormElement>(".machines .report-form").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const id = form.dataset.id;
          const ifVersion = Number(form.dataset.version);
          const status = (form.elements.namedItem("status") as HTMLSelectElement).value;
          const minutesRaw = (form.elements.namedItem("minutes") as HTMLInputElement).value;
          const minutes = minutesRaw === "" ? null : Number(minutesRaw);

          // No reporterId here — the actor is resolved server-side from
          // this browser's session cookie (see
          // notes/adr/0002-identity-and-permissions.md); the cookie is
          // sent automatically with same-origin fetch, nothing to attach
          // client-side.
          const res = await fetch(`/api/machines/${id}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              status,
              ifVersion,
              expectedEndAt:
                status === "in-use" && minutes !== null ? Date.now() + minutes * 60_000 : undefined,
            }),
          });

          if (res.ok) {
            // This session's own open SSE connection receives the same
            // broadcast every other open session does, so the card updates
            // itself the normal way — nothing left to do but tidy the form.
            const details = form.closest("details.report");
            if (details) (details as HTMLDetailsElement).open = false;
            return;
          }

          if (res.status === 409) {
            // Someone else's report, or a lazy decay, landed since this
            // card was rendered. Say so plainly, show the state the server
            // actually holds, and let the resident decide whether to
            // report again — never a silent overwrite and never a silent
            // reload either.
            const { current } = await res.json();
            applyMachineUpdate(current);
            const label = STATUS_META[current.status]?.label ?? current.status;
            alert(
              `This machine changed since you last saw it — it's now reported as "${label}". ` +
                "The card shows that now; check it and report again if it's still wrong.",
            );
            return;
          }

          alert("couldn't save that report — try again");
        });
      });
    </script>

    {/* Stage 2 (AA Room) — its own, separate state and script, not folded
        into the Laundry dashboard's applyMachineUpdate(): AA Room's
        canonical shape (AaRoomState) is deliberately not the Machine
        shape (see notes/adr/0003-aa-room-live-state.md), so this is its
        own small "render canonical state into these DOM nodes" function,
        the AA Room equivalent of applyMachineUpdate() above, not a reuse
        of it. Stage 3 wires this into the page's one shared SSE
        connection (src/lib/live-stream.ts) below — same connection
        Laundry's own script observes, no second EventSource. */}
    <script>
      import { onAaRoomEvent, onOpen } from "../lib/live-stream.ts";
      // Stage 4 — the 3D scene's only hook into AA Room's live updates,
      // the exact same cross-script-block sharing Laundry's own dashboard
      // script already relies on for applyMachineToScene (ES modules are
      // singletons keyed by URL, so this reaches the same scene.ts
      // module instance the separate AA Room mount script below also
      // imports — whichever one happens to have actually built the 3D
      // scene, since this call is a safe no-op via scene.ts's own
      // mountedAaRoomScenes Set when nothing has mounted yet, e.g. a
      // resident whose current tab is Laundry and has never switched to
      // AA Room at all).
      import { applyAaRoomStateToScene } from "../lib/hall-view/scene.ts";

      type AaRoomOccupancy = "empty" | "occupied" | "unknown";
      type AaRoomActivity = "tv" | "pool" | "table-tennis" | "hanging-out" | "event";
      interface AaRoomState {
        occupancy: AaRoomOccupancy;
        activities: AaRoomActivity[];
        confirmedAt: number | null;
        version: number;
        freshness: "fresh" | "stale" | null;
      }

      const STATUS_META: Record<AaRoomOccupancy, { label: string; icon: string; class: string }> = {
        empty: { label: "Empty", icon: "✓", class: "status-available" },
        occupied: { label: "Occupied", icon: "●", class: "status-in-use" },
        unknown: { label: "Unknown", icon: "?", class: "status-unknown" },
      };
      const ACTIVITY_META: Record<AaRoomActivity, { label: string }> = {
        tv: { label: "TV" },
        pool: { label: "Pool" },
        "table-tennis": { label: "Table tennis" },
        "hanging-out": { label: "Hanging out" },
        event: { label: "Event" },
      };

      // Mirrors confirmedLabel()/remainingLabel() elsewhere on this page —
      // both need the client's current clock, so neither can be shared
      // directly across the server/client boundary; kept tiny and
      // behaviourally identical instead of invented differently here.
      function confirmedLabel(confirmedAt: number | null): string {
        if (confirmedAt === null) return "never reported";
        const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
        if (minutes < 1) return "confirmed just now";
        return `confirmed ${minutes} min ago`;
      }

      function freshnessLabel(freshness: AaRoomState["freshness"]): { text: string; cls: string } | null {
        if (freshness === "fresh") return null;
        if (freshness === "stale") return { text: "this may be out of date", cls: "aa-freshness--stale" };
        return { text: "no recent enough report to show", cls: "aa-freshness--unknown" };
      }

      const panel = document.querySelector<HTMLElement>(".aa-room-panel");
      const statusEl = panel?.querySelector<HTMLElement>(".aa-room-status");
      const statusIconEl = panel?.querySelector<HTMLElement>(".aa-room-status-icon");
      const statusLabelEl = panel?.querySelector<HTMLElement>(".aa-room-status-label");
      const activityEl = panel?.querySelector<HTMLElement>(".aa-room-activity");
      const confirmedEl = panel?.querySelector<HTMLElement>(".aa-room-confirmed");
      const freshnessEl = panel?.querySelector<HTMLElement>(".aa-room-freshness");
      const form = panel?.querySelector<HTMLFormElement>(".aa-room-report-form");
      // v2: occupancy is two radio pills, not a <select> — a native
      // select can't be restyled into the same toggle-pill language as
      // .facility-tab/.block-tab elsewhere on this page, across browsers,
      // the way a radio+label pair can (see .aa-room-toggle CSS). Queried
      // as a plain array, same reasoning as activityCheckboxes below.
      const occupancyRadios = form
        ? Array.from(form.querySelectorAll<HTMLInputElement>('input[name="occupancy"]'))
        : [];
      function occupancyValue(): string | undefined {
        return occupancyRadios.find((r) => r.checked)?.value;
      }
      // v2: a checkbox per activity, replacing the single <select> —
      // queried as a live NodeList-turned-array so syncActivityControls()
      // can reason about "all of them" and "the event one specifically"
      // without re-querying the DOM on every call.
      const activityCheckboxes = form
        ? Array.from(form.querySelectorAll<HTMLInputElement>('input[name="activities"]'))
        : [];
      const eventCheckbox = activityCheckboxes.find((cb) => cb.value === "event") ?? null;
      const nonEventCheckboxes = activityCheckboxes.filter((cb) => cb.value !== "event");

      // Applies AA Room's canonical state to BOTH the panel and the 3D
      // scene — used for the initial server-rendered state (called once
      // below), this browser's own PATCH response (success or 409
      // conflict alike), and any other session's push over SSE. Mirrors
      // Laundry's own applyMachineUpdate(), which calls
      // applyMachineToScene() as its first line for exactly the same
      // reason: one canonical update path feeding both the dashboard and
      // the 3D view, so they can never disagree about what AA Room's
      // state currently is.
      function applyAaRoomUpdate(room: AaRoomState): void {
        applyAaRoomStateToScene(room);

        if (!statusEl || !statusIconEl || !statusLabelEl || !activityEl || !confirmedEl || !freshnessEl || !form) {
          return;
        }

        const meta = STATUS_META[room.occupancy];
        statusEl.className = `aa-room-status ${meta.class}`;
        statusIconEl.textContent = meta.icon;
        statusLabelEl.textContent = meta.label;

        if (room.activities.length > 0) {
          activityEl.hidden = false;
          activityEl.textContent = room.activities.map((activity) => ACTIVITY_META[activity].label).join(", ");
        } else {
          activityEl.hidden = true;
          activityEl.textContent = "";
        }

        confirmedEl.textContent = confirmedLabel(room.confirmedAt);

        const fresh = freshnessLabel(room.freshness);
        if (fresh) {
          freshnessEl.hidden = false;
          freshnessEl.className = `aa-room-freshness ${fresh.cls}`;
          freshnessEl.textContent = fresh.text;
        } else {
          freshnessEl.hidden = true;
          freshnessEl.textContent = "";
        }

        form.dataset.version = String(room.version);
      }

      // Recomputes EVERY checkbox's checked/disabled state from the
      // current full selection, every time anything changes — never a
      // one-way "disable on check" with no corresponding re-enable path,
      // which would leave a checkbox permanently stuck disabled after its
      // triggering condition no longer holds. See
      // notes/adr/0003-aa-room-live-state.md, "Validity constraints":
      // - occupancy "empty" -> every checkbox unchecked AND disabled.
      // - occupancy "occupied" + Event checked -> the other four
      //   unchecked AND disabled (Event stays enabled/checked).
      // - occupancy "occupied" + Event unchecked -> the other four
      //   re-enabled (never left disabled from an earlier Event
      //   selection that's since been undone).
      // - occupancy "occupied" + any of the other four checked -> Event
      //   unchecked AND disabled.
      // - occupancy "occupied" + all of the other four unchecked -> Event
      //   re-enabled (same "no stuck-disabled state" guarantee).
      function syncActivityControls(): void {
        if (occupancyRadios.length === 0 || activityCheckboxes.length === 0) return;
        const occupied = occupancyValue() === "occupied";

        if (!occupied) {
          for (const cb of activityCheckboxes) {
            cb.checked = false;
            cb.disabled = true;
          }
          return;
        }

        const eventChecked = eventCheckbox?.checked ?? false;
        const anyNonEventChecked = nonEventCheckboxes.some((cb) => cb.checked);

        if (eventCheckbox) eventCheckbox.disabled = anyNonEventChecked;
        for (const cb of nonEventCheckboxes) cb.disabled = eventChecked;
      }

      if (panel) {
        const initial = JSON.parse(panel.dataset.aaRoom!) as AaRoomState;
        applyAaRoomUpdate(initial);

        for (const radio of occupancyRadios) radio.addEventListener("change", syncActivityControls);

        // Enforces Event's mutual exclusivity the moment a resident
        // actually checks something — checking Event clears the other
        // four (and vice versa) — before syncActivityControls() computes
        // the resulting disabled state from that now-updated selection.
        // Both directions are needed: a one-way "disable the others"
        // alone wouldn't un-disable them again once Event is unchecked,
        // which is exactly syncActivityControls()'s own job on every
        // call, not just this one.
        for (const cb of activityCheckboxes) {
          cb.addEventListener("change", () => {
            if (cb === eventCheckbox && cb.checked) {
              for (const other of nonEventCheckboxes) other.checked = false;
            } else if (cb !== eventCheckbox && cb.checked && eventCheckbox) {
              eventCheckbox.checked = false;
            }
            syncActivityControls();
          });
        }

        syncActivityControls();

        // Stage 3 — a push from ANY session's report or decay transition,
        // over the page's one shared SSE connection. applyAaRoomUpdate()
        // only ever writes the display elements (status/activity-label/
        // confirmed/freshness/version) and never touches
        // occupancySelect.value or any activity checkbox's checked state,
        // so a resident mid-way through choosing their own report is
        // never overwritten by someone else's — the same property
        // Laundry's own applyMachineUpdate() already has for its report
        // form, not a new rule invented here. Deliberately NOT calling
        // syncActivityControls() here: that function reacts to this
        // browser's own occupancySelect/checkbox state, which an incoming
        // push never changes, so there's nothing for it to resync.
        onAaRoomEvent((room) => {
          applyAaRoomUpdate(room);
        });

        // Stage 3 — (re)connect re-fetches current AA Room state, the
        // same "a (re)connection's own read is itself a qualifying read"
        // principle the Laundry dashboard's onOpen() above already
        // relies on.
        onOpen(() => {
          fetch("/api/aa-room")
            .then((res) => res.json() as Promise<AaRoomState>)
            .then(applyAaRoomUpdate);
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const occupancy = occupancyValue()!;
          // Only checked AND currently-enabled boxes count — a box left
          // checked-but-disabled (which syncActivityControls() never
          // actually leaves behind, but this guards the submission itself
          // against relying on that) must never be submitted as part of
          // the resident's actual selection.
          const activities = activityCheckboxes
            .filter((cb) => cb.checked && !cb.disabled)
            .map((cb) => cb.value);
          const ifVersion = Number(form!.dataset.version);

          // No reporterId here, same as Laundry's own report script — the
          // actor is resolved server-side from this browser's session
          // cookie (notes/adr/0002-identity-and-permissions.md). Dedup/
          // canonical-order/event-exclusivity are all re-validated
          // server-side regardless of what the UI already enforced — see
          // src/pages/api/aa-room.ts.
          const res = await fetch("/api/aa-room", {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              occupancy,
              activities,
              ifVersion,
            }),
          });

          if (res.ok) {
            const room = (await res.json()) as AaRoomState;
            applyAaRoomUpdate(room);
            syncActivityControls();
            const details = form!.closest("details.report");
            if (details) (details as HTMLDetailsElement).open = false;
            return;
          }

          if (res.status === 409) {
            // Same conflict UX as Laundry's own report script: say so
            // plainly, show the state the server actually holds, let the
            // resident decide whether to report again — never a silent
            // overwrite, never a silent reload.
            const { current } = await res.json();
            applyAaRoomUpdate(current as AaRoomState);
            syncActivityControls();
            const label = STATUS_META[(current as AaRoomState).occupancy]?.label ?? (current as AaRoomState).occupancy;
            alert(
              `AA Room changed since you last saw it — it's now reported as "${label}". ` +
                "The panel shows that now; check it and report again if it's still wrong.",
            );
            return;
          }

          alert("couldn't save that report — try again");
        });
      }
    </script>

    {/* Otter Room — its own, separate state and script, same shape as AA
        Room's script above: OtterRoomState is deliberately not the
        Machine or AaRoomState shape (no activities, no freshness — see
        notes/adr/0004-otter-room-live-state.md), so this is its own
        small "render canonical state into these DOM nodes" function.
        Wired into the page's one shared SSE connection
        (src/lib/live-stream.ts) from the start — no separate "Stage 3"
        step the way AA Room had, since Otter Room's backend already
        ships realtime support. Also feeds the 3D scene via
        applyOtterRoomStateToScene() (src/lib/hall-view/scene.ts), the
        exact same cross-script-block sharing Laundry's/AA Room's own
        scripts already rely on for their own scene hooks — a safe no-op
        via scene.ts's mountedOtterRoomScenes Set when nothing has mounted
        yet (e.g. a resident whose current tab is Laundry and has never
        switched to Otter Room). */}
    <script>
      import { onOtterRoomEvent, onOpen } from "../lib/live-stream.ts";
      import { applyOtterRoomStateToScene } from "../lib/hall-view/scene.ts";

      type OtterRoomOccupancy = "empty" | "occupied" | "unknown";
      interface OtterRoomState {
        occupancy: OtterRoomOccupancy;
        expectedEndAt: number | null;
        confirmedAt: number | null;
        version: number;
      }

      const STATUS_META: Record<OtterRoomOccupancy, { label: string; icon: string; class: string }> = {
        empty: { label: "Empty", icon: "✓", class: "status-available" },
        occupied: { label: "Occupied", icon: "●", class: "status-in-use" },
        unknown: { label: "Unknown", icon: "?", class: "status-unknown" },
      };

      // Mirrors confirmedLabel()/remainingLabel() elsewhere on this page —
      // all need the client's current clock, so none can be shared
      // directly across the server/client boundary; kept tiny and
      // behaviourally identical instead of invented differently here.
      function confirmedLabel(confirmedAt: number | null): string {
        if (confirmedAt === null) return "never reported";
        const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
        if (minutes < 1) return "confirmed just now";
        return `confirmed ${minutes} min ago`;
      }

      function remainingLabel(expectedEndAt: number | null): { text: string; known: boolean } {
        if (expectedEndAt === null) return { text: "remaining time unknown", known: false };
        const minutes = Math.round((expectedEndAt - Date.now()) / 60_000);
        return minutes > 0
          ? { text: `${minutes} min left`, known: true }
          : { text: "should be finishing", known: true };
      }

      const panel = document.querySelector<HTMLElement>(".otter-room-panel");
      const statusEl = panel?.querySelector<HTMLElement>(".otter-room-status");
      const statusIconEl = panel?.querySelector<HTMLElement>(".otter-room-status-icon");
      const statusLabelEl = panel?.querySelector<HTMLElement>(".otter-room-status-label");
      const remainingEl = panel?.querySelector<HTMLElement>(".otter-room-remaining");
      const confirmedEl = panel?.querySelector<HTMLElement>(".otter-room-confirmed");
      const form = panel?.querySelector<HTMLFormElement>(".otter-room-report-form");
      const occupancyRadios = form
        ? Array.from(form.querySelectorAll<HTMLInputElement>('input[name="occupancy"]'))
        : [];
      const minutesInput = form?.querySelector<HTMLInputElement>('input[name="minutes"]') ?? null;
      function occupancyValue(): string | undefined {
        return occupancyRadios.find((r) => r.checked)?.value;
      }

      // Applies Otter Room's canonical state to the panel — used for the
      // initial server-rendered state (called once below), this
      // browser's own PATCH response (success or 409 conflict alike),
      // and any other session's push over SSE. Mirrors Laundry's
      // applyMachineUpdate() and AA Room's applyAaRoomUpdate(): one
      // canonical update path, never a second client-side state model to
      // drift from the server's.
      function applyOtterRoomUpdate(room: OtterRoomState): void {
        applyOtterRoomStateToScene(room);

        if (!statusEl || !statusIconEl || !statusLabelEl || !remainingEl || !confirmedEl || !form) {
          return;
        }

        const meta = STATUS_META[room.occupancy];
        statusEl.className = `otter-room-status ${meta.class}`;
        statusIconEl.textContent = meta.icon;
        statusLabelEl.textContent = meta.label;

        if (room.occupancy === "occupied") {
          const remaining = remainingLabel(room.expectedEndAt);
          remainingEl.hidden = false;
          remainingEl.classList.toggle("unknown-time", !remaining.known);
          remainingEl.textContent = remaining.text;
        } else {
          remainingEl.hidden = true;
          remainingEl.textContent = "";
        }

        confirmedEl.textContent = confirmedLabel(room.confirmedAt);

        form.dataset.version = String(room.version);
      }

      // Disables (and clears) the minutes input whenever occupancy isn't
      // "occupied" — the direct guarantee that an Empty report never
      // carries a leftover estimate (ADR 0004, Decision 2: expectedEndAt
      // is per-observation, never inherited). Recomputed from the full
      // current selection every time anything changes, same "never a
      // one-way disable with no re-enable path" discipline AA Room's own
      // syncActivityControls() uses.
      function syncMinutesInput(): void {
        if (!minutesInput) return;
        const occupied = occupancyValue() === "occupied";
        minutesInput.disabled = !occupied;
        if (!occupied) minutesInput.value = "";
      }

      if (panel) {
        const initial = JSON.parse(panel.dataset.otterRoom!) as OtterRoomState;
        applyOtterRoomUpdate(initial);

        for (const radio of occupancyRadios) radio.addEventListener("change", syncMinutesInput);
        syncMinutesInput();

        // A push from ANY session's report or decay transition, over the
        // page's one shared SSE connection. applyOtterRoomUpdate() only
        // ever writes the display elements and never touches
        // occupancyRadios/minutesInput, so a resident mid-way through
        // choosing their own report is never overwritten by someone
        // else's — the same property Laundry's/AA Room's own report
        // forms already have.
        onOtterRoomEvent((room) => {
          applyOtterRoomUpdate(room);
        });

        // (Re)connect re-fetches current Otter Room state — the same
        // "a (re)connection's own read is itself a qualifying read"
        // principle every other facility's onOpen() handler already
        // relies on.
        onOpen(() => {
          fetch("/api/otter-room")
            .then((res) => res.json() as Promise<OtterRoomState>)
            .then(applyOtterRoomUpdate);
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const occupancy = occupancyValue()!;
          // Only read when occupied AND the input is actually enabled —
          // mirrors AA Room's own "checked AND currently-enabled" guard
          // on its activity checkboxes, so a stale value sitting in a
          // disabled input can never be submitted as part of an Empty
          // report even if syncMinutesInput() somehow hadn't cleared it.
          const minutesRaw = occupancy === "occupied" && minutesInput && !minutesInput.disabled
            ? minutesInput.value
            : "";
          const minutes = minutesRaw === "" ? null : Number(minutesRaw);
          const ifVersion = Number(form!.dataset.version);

          // No reporterId here, same as every other facility's report
          // script — the actor is resolved server-side from this
          // browser's session cookie
          // (notes/adr/0002-identity-and-permissions.md). expectedEndAt
          // is only ever sent when occupied and a minute estimate was
          // actually given — an Empty report, or an occupied report with
          // no estimate, omits the field entirely, which the server
          // treats as "no estimate for this report" and stores as null
          // (ADR 0004, Decision 2: never inherited from a prior report).
          const res = await fetch("/api/otter-room", {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              occupancy,
              ifVersion,
              expectedEndAt:
                occupancy === "occupied" && minutes !== null ? Date.now() + minutes * 60_000 : undefined,
            }),
          });

          if (res.ok) {
            const room = (await res.json()) as OtterRoomState;
            applyOtterRoomUpdate(room);
            syncMinutesInput();
            return;
          }

          if (res.status === 409) {
            // Same conflict UX as every other facility's report script:
            // say so plainly, show the state the server actually holds,
            // let the resident decide whether to report again — never a
            // silent overwrite, never a silent reload. Mirrors AA Room's
            // own handling exactly: applyOtterRoomUpdate() only touches
            // the display elements, and syncMinutesInput() reacts to
            // THIS browser's own still-selected radio, which an incoming
            // conflict never changes — the resident's in-progress
            // selection is left alone, same as every other facility.
            const { current } = await res.json();
            applyOtterRoomUpdate(current as OtterRoomState);
            syncMinutesInput();
            const label = STATUS_META[(current as OtterRoomState).occupancy]?.label ?? (current as OtterRoomState).occupancy;
            alert(
              `Otter Room changed since you last saw it — it's now reported as "${label}". ` +
                "The panel shows that now; check it and report again if it's still wrong.",
            );
            return;
          }

          alert("couldn't save that report — try again");
        });
      }
    </script>

    {/* Rabbit Room — its own, separate state and script, same shape as
        Otter Room's script above: RabbitRoomState is deliberately not
        the Machine or AaRoomState shape (no activities, no freshness —
        see notes/adr/0005-rabbit-room-live-state.md), so this is its own
        small "render canonical state into these DOM nodes" function.
        Wired into the page's one shared SSE connection
        (src/lib/live-stream.ts) from the start. Also feeds the 3D scene
        via applyRabbitRoomStateToScene() (src/lib/hall-view/scene.ts),
        the exact same cross-script-block sharing every other facility's
        own scripts already rely on for their own scene hooks — a safe
        no-op via scene.ts's mountedRabbitRoomScenes Set when nothing has
        mounted yet (e.g. a resident whose current tab is Laundry and has
        never switched to Rabbit Room). */}
