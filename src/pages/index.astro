        freshness: "fresh" | "stale" | null;
      }

      const aaRoomContainer = document.getElementById("aa-room-canvas");
      const aaRoomSection = aaRoomContainer?.closest<HTMLElement>(".hall-view") ?? null;

      if (aaRoomContainer && aaRoomSection && aaRoomSection.dataset.aaRoom) {
        let built = false;
        onFacilitySelected("aa-room", () => {
          if (built) {
            activateFacility("aa-room", aaRoomContainer);
            return;
          }
          built = true;
          try {
            const initial = JSON.parse(aaRoomSection.dataset.aaRoom!) as AaRoomSceneState;
            mountAaRoom(aaRoomContainer, initial);
          } catch {
            // Same fallback as Laundry's own mount — WebGL unavailable,
            // or anything else went wrong building the scene. The AA
            // Room panel below is a complete experience on its own
            // either way.
            aaRoomContainer.remove();
            aaRoomSection.querySelector(".hall-view-caption")?.remove();
          }
        });
      }
    </script>

