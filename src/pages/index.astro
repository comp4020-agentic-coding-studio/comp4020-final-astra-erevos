  </head>
  <body data-status-meta={JSON.stringify(STATUS_META)}>
    <main>
      <header class="hero">
        <h1>Toad Live</h1>
        <p>
          Shared spaces across Toad Hall — reported by residents, not
          sensors. See <a href="/readme/">what "good" means here</a>.
        </p>
        <p class="identity">You're reporting as <strong>{pseudonym}</strong></p>
      </header>

      {/* Stage 6 — facility tabs. Toad Live's original concept was every
          shared space in the Hall, not laundry specifically; Laundry is
          the only tab backed by real data today. The other six are
          plain disabled buttons — visible so the app's intended shape is
          legible, inert so nothing here implies a working page or
          invented data behind them. aria-current="page" on the one real
          tab, not a class alone, so assistive tech gets the same signal
          sighted users get from its filled-in style. */}
      {/* Stage 2 (AA Room) — Laundry and AA Room are now both real,
          clickable tabs; the other five stay exactly as they were
          (plain disabled buttons, no route, no invented data). Each
          clickable tab carries data-facility, read by the script below
          to show/hide that facility's hall-view-pane and info-panel
          content — nothing here duplicates machine or AA Room data, it
          only ever toggles which already-rendered panel is visible. */}
      <nav class="facility-tabs" aria-label="Shared spaces">
        <button type="button" class="facility-tab" data-facility="laundry" aria-current="page">Laundry</button>
        <button type="button" class="facility-tab" data-facility="aa-room">AA Room</button>
        <button type="button" class="facility-tab" data-facility="otter-room">Otter Room</button>
        <button type="button" class="facility-tab" data-facility="rabbit-room">Rabbit Room</button>
        <button type="button" class="facility-tab" disabled>Badger Room</button>
        <button type="button" class="facility-tab" disabled>Rat Room</button>
        <button type="button" class="facility-tab" disabled>Weasel Room</button>
      </nav>

      {/* Stage 6 — the 70/30 desktop workbench: hall-view-pane (left) and
          info-panel (right) below are a pure CSS reshaping of exactly
          the same two sections this page already had — the hall-view
          <section> and the summary/halls <section>s are UNCHANGED
          markup, just re-parented into this grid (see index.astro's own
          CSS notes on .workbench/.hall-view-pane/.info-panel). Below
          64rem this grid collapses and these wrapper divs have no
          layout effect at all, so mobile/tablet renders source-order
          identically to how the page always has. */}
      <div class="workbench">
        <div class="hall-view-pane">
          {/* Live Hall View — Stage 3: all five real laundry rooms, a visual
              layer above the dashboard, never a replacement for it.
              aria-hidden because every fact it shows is already stated as
              accessible text below; a screen-reader user loses nothing by
              this section being skipped entirely. Initialized once from
              this page load's real state via data-machines, then kept live
              by the dashboard script's existing applyMachineUpdate() below
              (see scene.ts's applyMachineToScene note).

              Stage 2 (AA Room) — wrapped in data-facility="laundry" so the
              facility-tab script can hide it when AA Room is selected;
              nothing inside this wrapper changes. */}
          <div class="facility-view" data-facility="laundry">
            <section
              class="hall-view"
              aria-hidden="true"
              data-machines={JSON.stringify(hallViewMachines)}
            >
              <div class="hall-view-canvas" id="hall-view-canvas"></div>
              <p class="hall-view-caption">Toad Hall — live laundry miniature</p>
            </section>
          </div>

          {/* AA Room's left pane — Stage 4: a real 3D diorama, same
              cutaway low-poly language as Laundry's, mounted onto the
              ONE shared renderer (src/lib/hall-view/renderer-host.ts),
              never a second WebGLRenderer. aria-hidden for the same
              reason Laundry's hall-view is: every fact it shows is
              already stated as accessible text in the AA Room panel
              below. Hidden by default; the facility-tab script shows it
              only when AA Room is selected. data-aa-room is the same
              initial-state-from-this-page-load payload the AA Room
              panel's own script already reads from the info panel
              below — read once here too so the 3D mount has the real
              starting state without a second fetch. */}
          <div class="facility-view" data-facility="aa-room" hidden>
            <section class="hall-view" aria-hidden="true" data-aa-room={JSON.stringify(aaRoom)}>
              <div class="hall-view-canvas" id="aa-room-canvas"></div>
              <p class="hall-view-caption">Toad Hall — AA Room, live</p>
            </section>
          </div>

          {/* Otter Room's left pane — a real 3D diorama (table, chairs,
              whiteboard, window, heater), same cutaway low-poly language
              as Laundry's/AA Room's, mounted onto the ONE shared renderer
              (src/lib/hall-view/renderer-host.ts), never a second
              WebGLRenderer. aria-hidden for the same reason Laundry's/AA
              Room's hall-view are: every fact it shows is already stated
              as accessible text in the Otter Room panel below. Hidden by
              default; the facility-tab script shows it only when Otter
              Room is selected. data-otter-room is the same
              initial-state-from-this-page-load payload the Otter Room
              panel's own script already reads from the info panel below —
              read once here too so the 3D mount has the real starting
              state without a second fetch. See
              notes/adr/0004-otter-room-live-state.md. */}
          <div class="facility-view" data-facility="otter-room" hidden>
            <section class="hall-view" aria-hidden="true" data-otter-room={JSON.stringify(otterRoom)}>
              <div class="hall-view-canvas" id="otter-room-canvas"></div>
              <p class="hall-view-caption">Toad Hall — Otter Room, live</p>
            </section>
          </div>

          {/* Rabbit Room's left pane — a real 3D diorama (two windows, a
              whiteboard, the joined-desks centre table, chairs, a kitchen
              zone at the far end, plus decorative occupied-only figures —
              see src/lib/hall-view/rabbit-room.ts), mounted onto the ONE
              shared renderer (src/lib/hall-view/renderer-host.ts), never a
              second WebGLRenderer. aria-hidden for the same reason every
              other facility's hall-view is: every fact it shows is
              already stated as accessible text in the Rabbit Room panel
              below. Hidden by default; the facility-tab script shows it
              only when Rabbit Room is selected. data-rabbit-room is the
              same initial-state-from-this-page-load payload the Rabbit
              Room panel's own script already reads from the info panel
              below — read once here too so the 3D mount has the real
              starting state without a second fetch. See
              notes/adr/0005-rabbit-room-live-state.md. */}
          <div class="facility-view" data-facility="rabbit-room" hidden>
            <section class="hall-view" aria-hidden="true" data-rabbit-room={JSON.stringify(rabbitRoom)}>
              <div class="hall-view-canvas" id="rabbit-room-canvas"></div>
              <p class="hall-view-caption">Toad Hall — Rabbit Room, live</p>
            </section>
          </div>
        </div>

        <div class="info-panel">
      <div class="facility-view" data-facility="laundry">
      <section class="summary" aria-label="Laundry summary">
        {summary.map(({ key, count }) => (
          <div class:list={["stat", key]}>
            <span class="value">{count}</span>
            <span class="label"><span class="dot"></span>{STATUS_META[key].label.toLowerCase()}</span>
          </div>
        ))}
      </section>

      {/* Stage 7 — block tabs: a pure VIEW filter over this same markup,
          not a second machine list. Each .hall keeps data-location so
          the dashboard script below can show/hide whole <article>s by
          toggling [hidden] — no machine, status, or summary data is
          read, duplicated, or recomputed by that script; it only ever
          flips which of these already-rendered blocks the browser
          paints. Mirrors the facility-tabs' own aria-current="page"
          pattern for the active indicator. */}
      <nav class="block-tabs" aria-label="Filter by block">
        {LOCATIONS.map((location, index) => (
          <button
            type="button"
            class="block-tab"
            data-location={location}
            aria-current={index === 0 ? "true" : undefined}
          >
            {location}
          </button>
        ))}
      </nav>

      <section class="halls">
        {LOCATIONS.map((location, index) => (
          <article class="hall" data-location={location} hidden={index !== 0}>
            <h2 class="zone-label">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-6.5-5.8-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.2-6.5 11-6.5 11z" />
                <circle cx="12" cy="10" r="2.2" />
              </svg>
              Block {location}
            </h2>
            <div class="machines">
              {byLocation.get(location)!.map((machine) => {
                const meta = STATUS_META[machine.status];
                const remaining = machine.status === "in-use" ? remainingLabel(machine) : null;
                const broken = machine.status === "out-of-order";
                return (
                  <div
                    class:list={["machine", broken && "machine--broken"]}
                    data-machine={machine.id}
                    data-status={machine.status}
                  >
                    <div class="machine-head">
                      <span class="machine-icon-chip" aria-hidden="true">
                        {machine.type === "washer" ? (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="2.5" width="18" height="19" rx="3" />
                            <circle cx="12" cy="13" r="6" />
                            <path d="M9 13c.8-1 1.5-1 2 0s1.2 1 2 0" />
                            <circle cx="6.5" cy="5.5" r="0.6" fill="currentColor" stroke="none" />
                            <circle cx="9" cy="5.5" r="0.6" fill="currentColor" stroke="none" />
                          </svg>
                        ) : (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="2.5" width="18" height="19" rx="3" />
                            <circle cx="12" cy="13" r="6" />
                            <path d="M9.5 15.3a3.2 3.2 0 0 1 4.6-4" />
                            <path d="M14.5 10.7a3.2 3.2 0 0 1-4.6 4" />
                            <line x1="6.5" y1="5.5" x2="9" y2="5.5" />
                          </svg>
                        )}
                      </span>
                      <span class="machine-type">{machine.type}</span>
                      <span class:list={["badge", meta.class]}>
                        <span aria-hidden="true">{meta.icon}</span>{meta.label}
                      </span>
                    </div>

                    {/* Always rendered, hidden when not in-use, so a live
                        update has a stable node to toggle rather than
                        needing to build this element from scratch in JS. */}
                    <p
                      class:list={["remaining", remaining && !remaining.known && "unknown-time"]}
                      hidden={!remaining}
                    >
                      {remaining ? remaining.text : ""}
                    </p>
                    <span class="confirmed">{confirmedLabel(machine.confirmedAt)}</span>

                    <details class="report">
                      <summary>Update status</summary>
                      <form class="report-form" data-id={machine.id} data-version={machine.version}>
                        <select name="status" aria-label={`New status for ${location} ${machine.type}`}>
                          <option value="available">Available</option>
                          <option value="in-use">In use</option>
                          <option value="out-of-order">Out of order</option>
                        </select>
                        <input
                          type="number"
                          name="minutes"
                          min="0"
                          placeholder="minutes left (optional)"
                          aria-label="Minutes remaining, optional"
                        />
                        <button type="submit">Report</button>
                      </form>
                    </details>
                  </div>
                );
              })}
            </div>
          </article>
        ))}
      </section>
      </div>

      {/* AA Room's practical panel — Stage 2: reads from the canonical
          /api/aa-room state passed down via data-aa-room (the same
          "initial render from this page load's real state, then kept
          live by its own script" shape the Laundry panel already uses
          for `machines`). Hidden by default, shown only when the AA Room
          facility tab is selected. No block-tabs: AA Room is one room,
          not five locations. */}
      <div class="facility-view aa-room-panel" data-facility="aa-room" hidden data-aa-room={JSON.stringify(aaRoom)}>
        <section class="summary aa-room-summary" aria-label="AA Room status">
          <div class:list={["aa-room-status", AA_ROOM_STATUS_META[aaRoom.occupancy].class]}>
            <span class="aa-room-status-icon" aria-hidden="true">{AA_ROOM_STATUS_META[aaRoom.occupancy].icon}</span>
            <span class="aa-room-status-label">{AA_ROOM_STATUS_META[aaRoom.occupancy].label}</span>
          </div>
          {/* Always rendered, hidden when there are no activities to show —
              same "stable node, toggled, never built from scratch" shape as
              Laundry's .remaining paragraph. v2: activities is a list, so
              this joins every currently-reported tag's label rather than
              showing a single value (notes/adr/0003-aa-room-live-state.md,
              "Design correction, v2"). Never a hardcoded fallback label
              when activities is empty — an empty array there means
              "nothing specific to report," not a gap to invent a label
              for. */}
          <p class="aa-room-activity" hidden={aaRoom.activities.length === 0}>
            {aaRoom.activities.map((activity) => AA_ROOM_ACTIVITY_META[activity].label).join(", ")}
          </p>
          <span class="confirmed aa-room-confirmed">{aaRoomConfirmedLabel(aaRoom.confirmedAt)}</span>
          {(() => {
            const fresh = aaRoomFreshnessLabel(aaRoom.freshness);
            return (
              <p class:list={["aa-room-freshness", fresh?.class]} hidden={!fresh}>
                {fresh?.text ?? ""}
              </p>
            );
          })()}
        </section>

        {/* AA Room has exactly one reportable thing — unlike Laundry's ten
            separate machine cards, where collapsing each one behind
            "Update status" cuts real clutter, hiding AA Room's only form
            behind a click bought nothing but an extra click. Always
            visible, and styled as the same pill-button language as
            .facility-tab/.block-tab elsewhere on this page, rather than a
            native <select>/checkbox list — see .aa-room-toggle-group
            below. */}
        <div class="report aa-room-report">
          <p class="aa-room-report-label">Update status</p>
          {/* Only empty/occupied are ever offered — unknown is never a
              reportable value (ADR 0003, Decision 2): it's what seeding or
              decay produces, never something a resident observes and
              reports. data-version is kept in sync with every canonical
              state this panel receives, the same way Laundry's
              .report-form does. Occupancy is two radios, not a <select>,
              specifically so it can be styled as the same toggle-pill
              group as the activities below it — a native select can't be
              restyled into pills across browsers the way a radio+label
              pair can. */}
          <form class="report-form aa-room-report-form" data-version={aaRoom.version}>
            {/* Pre-checked from this page load's real occupancy, same
                "initial render reflects canonical state, not a blank
                form" discipline as every other field in this panel —
                "unknown" (never a reportable value, Decision 2) simply
                leaves neither pill checked rather than guessing one. */}
            <fieldset class="aa-room-toggle-group aa-room-occupancy" aria-label="AA Room status">
              <label class="aa-room-toggle">
                <input type="radio" name="occupancy" value="empty" checked={aaRoom.occupancy === "empty"} />
                <span>Empty</span>
              </label>
              <label class="aa-room-toggle">
                <input type="radio" name="occupancy" value="occupied" checked={aaRoom.occupancy === "occupied"} />
                <span>Occupied</span>
              </label>
            </fieldset>
            {/* v2: a multi-select toggle group replaces the single
                activity <select> — tv/pool/table-tennis/hanging-out can be
                toggled in any combination; "Hall event" is mutually
                exclusive with the other four (the report script's
                syncActivityControls() enforces this both ways: checking
                Event disables the other four, checking any of the other
                four disables Event — see notes/adr/0003-aa-room-live-
                state.md, "Validity constraints"). Disabled together
                whenever occupancy isn't "occupied", same "never carry a
                stale selection into the wrong kind of report" discipline
                the old single-select had. Pre-checked from the real
                current activities for the same reason occupancy is. */}
            <fieldset class="aa-room-toggle-group aa-room-activities" aria-label="What's happening">
              {(["tv", "pool", "table-tennis", "hanging-out", "event"] as const).map((activity) => (
                <label class="aa-room-toggle">
                  <input
                    type="checkbox"
                    name="activities"
                    value={activity}
                    checked={aaRoom.activities.includes(activity)}
                    disabled={aaRoom.occupancy !== "occupied"}
                  />
                  <span>{AA_ROOM_ACTIVITY_META[activity].checkboxLabel}</span>
                </label>
              ))}
            </fieldset>
            <button type="submit">Report</button>
          </form>
        </div>
      </div>

      {/* Otter Room's practical panel — same "initial render from this page
          load's real state, then kept live by its own script" shape as
          AA Room's panel above, but reading /api/otter-room's own shape
          (occupancy + optional expectedEndAt, no activities, no
          freshness — see notes/adr/0004-otter-room-live-state.md,
          Decision 1/4). Hidden by default; the facility-tab script shows
          it only when Otter Room is selected. No block-tabs: Otter Room
          is one room, not five locations. */}
      <div
        class="facility-view otter-room-panel"
        data-facility="otter-room"
        hidden
        data-otter-room={JSON.stringify(otterRoom)}
      >
        <section class="summary otter-room-summary" aria-label="Otter Room status">
          <div class:list={["otter-room-status", OTTER_ROOM_STATUS_META[otterRoom.occupancy].class]}>
            <span class="otter-room-status-icon" aria-hidden="true">{OTTER_ROOM_STATUS_META[otterRoom.occupancy].icon}</span>
            <span class="otter-room-status-label">{OTTER_ROOM_STATUS_META[otterRoom.occupancy].label}</span>
          </div>
          {/* Always rendered, hidden when not occupied — same "stable node,
              toggled, never built from scratch" shape as Laundry's
              .remaining paragraph, since Otter Room's expectedEndAt is the
              same kind of optional, never-fabricated signal (ADR 0004,
              Decision 1). */}
          <p
            class:list={[
              "remaining",
              "otter-room-remaining",
              otterRoom.occupancy === "occupied" &&
                otterRoomRemainingLabel(otterRoom.expectedEndAt).known === false &&
                "unknown-time",
            ]}
            hidden={otterRoom.occupancy !== "occupied"}
          >
            {otterRoom.occupancy === "occupied" ? otterRoomRemainingLabel(otterRoom.expectedEndAt).text : ""}
          </p>
          <span class="confirmed otter-room-confirmed">{otterRoomConfirmedLabel(otterRoom.confirmedAt)}</span>
        </section>

        {/* Otter Room has exactly one reportable thing, same reasoning as
            AA Room's own always-visible form (no details/summary
            click-to-reveal — see .aa-room-report's own note). Only
            empty/occupied are ever offered — unknown is never a
            reportable value (ADR 0004, Decision 1). The occupancy toggle
            reuses .aa-room-toggle/.aa-room-toggle-group's exact pill
            styling — a shared visual component for a binary/multi-select
            toggle group, not an AA-Room-specific one, despite the class
            name's origin; reusing it here avoids a second, identical CSS
            block for the same visual pattern. */}
        <div class="report otter-room-report">
          <p class="aa-room-report-label">Update status</p>
          {/* data-version kept in sync with every canonical state this
              panel receives, same as Laundry's/AA Room's own forms. The
              minutes input mirrors Laundry's dryer estimate field exactly
              (a plain optional number-of-minutes-from-now, converted to
              an absolute expectedEndAt on submit) — the simplest, fastest
              interaction already proven there, not a new time-picker
              invented for this facility. See notes/adr/0004-otter-room-
              live-state.md: no booking calendar, no future reservation. */}
          <form class="report-form otter-room-report-form" data-version={otterRoom.version}>
            <fieldset class="aa-room-toggle-group otter-room-occupancy" aria-label="Otter Room status">
              <label class="aa-room-toggle">
                <input type="radio" name="occupancy" value="empty" checked={otterRoom.occupancy === "empty"} />
                <span>Empty</span>
              </label>
              <label class="aa-room-toggle">
                <input type="radio" name="occupancy" value="occupied" checked={otterRoom.occupancy === "occupied"} />
                <span>Occupied</span>
              </label>
            </fieldset>
            {/* Disabled (and cleared, by the report script's sync
                function) whenever occupancy isn't "occupied" — the same
                "never carry a stale value into the wrong kind of report"
                discipline AA Room's activity checkboxes already use, and
                the direct answer to "ensure submission doesn't carry an
                old value" for an Empty report: a disabled, emptied input
                has nothing to submit in the first place. Capped at 240
                (4 hours) client-side as a fast-feedback mirror of the
                server's own real ceiling (ADR 0004, Decision 2) — the
                server re-validates regardless, this is just UX, not the
                actual guard. */}
            <input
              type="number"
              name="minutes"
              min="1"
              max="240"
              placeholder="minutes left (optional)"
              aria-label="Expected minutes remaining, optional"
              disabled={otterRoom.occupancy !== "occupied"}
            />
            <button type="submit">Report</button>
          </form>
        </div>
      </div>

      {/* Rabbit Room's practical panel — same shape as Otter Room's panel
          above, reusing the exact same reporting semantics since ADR 0005
          independently confirmed the same occupancy + optional
          expectedEndAt model for this room's own facts (no activities, no
          headcount, no freshness — see
          notes/adr/0005-rabbit-room-live-state.md). Hidden by default;
          the facility-tab script shows it only when Rabbit Room is
          selected. No block-tabs: Rabbit Room is one room. */}
      <div
        class="facility-view rabbit-room-panel"
        data-facility="rabbit-room"
        hidden
        data-rabbit-room={JSON.stringify(rabbitRoom)}
      >
        <section class="summary rabbit-room-summary" aria-label="Rabbit Room status">
          <div class:list={["rabbit-room-status", RABBIT_ROOM_STATUS_META[rabbitRoom.occupancy].class]}>
            <span class="rabbit-room-status-icon" aria-hidden="true">{RABBIT_ROOM_STATUS_META[rabbitRoom.occupancy].icon}</span>
            <span class="rabbit-room-status-label">{RABBIT_ROOM_STATUS_META[rabbitRoom.occupancy].label}</span>
          </div>
          {/* Always rendered, hidden when not occupied — same "stable node,
              toggled, never built from scratch" shape as Otter Room's own
              .remaining paragraph. */}
          <p
            class:list={[
              "remaining",
              "rabbit-room-remaining",
              rabbitRoom.occupancy === "occupied" &&
                rabbitRoomRemainingLabel(rabbitRoom.expectedEndAt).known === false &&
                "unknown-time",
            ]}
            hidden={rabbitRoom.occupancy !== "occupied"}
          >
            {rabbitRoom.occupancy === "occupied" ? rabbitRoomRemainingLabel(rabbitRoom.expectedEndAt).text : ""}
          </p>
          <span class="confirmed rabbit-room-confirmed">{rabbitRoomConfirmedLabel(rabbitRoom.confirmedAt)}</span>
        </section>

        {/* Rabbit Room has exactly one reportable thing, same reasoning as
            Otter Room's own always-visible form. Only empty/occupied are
            ever offered — unknown is never a reportable value (ADR 0005,
            Decision 1). Reuses .aa-room-toggle/.aa-room-toggle-group's
            exact pill styling, same shared component every other
            facility's occupancy toggle already uses. */}
        <div class="report rabbit-room-report">
          <p class="aa-room-report-label">Update status</p>
          {/* data-version kept in sync with every canonical state this
              panel receives, same as every other facility's own form. The
              minutes input mirrors Otter Room's estimate field exactly —
              the same simplest, fastest interaction, not a new time-picker
              invented for this facility. See
              notes/adr/0005-rabbit-room-live-state.md: no booking
              calendar, no future reservation. */}
          <form class="report-form rabbit-room-report-form" data-version={rabbitRoom.version}>
            <fieldset class="aa-room-toggle-group rabbit-room-occupancy" aria-label="Rabbit Room status">
              <label class="aa-room-toggle">
                <input type="radio" name="occupancy" value="empty" checked={rabbitRoom.occupancy === "empty"} />
                <span>Empty</span>
              </label>
              <label class="aa-room-toggle">
                <input type="radio" name="occupancy" value="occupied" checked={rabbitRoom.occupancy === "occupied"} />
                <span>Occupied</span>
              </label>
            </fieldset>
            {/* Disabled (and cleared, by the report script's sync
                function) whenever occupancy isn't "occupied" — same
                "never carry a stale value into the wrong kind of report"
                discipline every other facility's own form already uses.
                Capped at 240 (4 hours) client-side as a fast-feedback
                mirror of the server's own real ceiling (ADR 0005,
                Decision 2) — the server re-validates regardless, this is
                just UX, not the actual guard. */}
            <input
              type="number"
              name="minutes"
              min="1"
              max="240"
              placeholder="minutes left (optional)"
              aria-label="Expected minutes remaining, optional"
              disabled={rabbitRoom.occupancy !== "occupied"}
            />
            <button type="submit">Report</button>
          </form>
        </div>
      </div>
        </div>
      </div>
    </main>

    {/* Live Hall View mount — its own inline script block, still
        touching only the hall-view-canvas element, never the dashboard
        markup. Stage 2.3: the dashboard's own script (next) now imports
        applyMachineToScene from this same scene.ts module to feed it
        live updates — see that import's own note on how two separate
        inline script blocks share one module instance. Nothing here
        changes: this block still only mounts the scene from the
        page's initial state; it's the *other* script that reaches
        into this module now, not this one reaching out. */}
    {/* Stage 2 (AA Room) — facility-tab switching: a pure VIEW filter,
        the same "toggle [hidden] on already-rendered content, read/write
        no machine or AA Room data" shape as the block-tabs script below.
        Its own, separate inline script block — not a literal tag written
        out in this comment, since a naive scanner can mistake that for a
        real script boundary — independent of the two that follow, since
        it owns none of their state and neither of them needs to know
        this one exists. */}
    <script>
      // Stage 4 — notifies whichever facility's 3D mount script
      // registered interest (src/lib/hall-view/facility-switch.ts) every
      // time a facility tab is selected, including the very first
      // selection a resident ever makes of a given facility. This is
      // what lets AA Room's 3D scene be built lazily, on first switch to
      // it, rather than eagerly at page load while hidden — see that
      // module's own note, and the AA Room mount script further down.
      import { selectHallFacility } from "../lib/hall-view/facility-switch.ts";

      const facilityTabs = document.querySelectorAll<HTMLButtonElement>(".facility-tab[data-facility]");
      const facilityViews = document.querySelectorAll<HTMLElement>(".facility-view[data-facility]");

      function selectFacility(facility: string): void {
        for (const view of facilityViews) {
          view.hidden = view.dataset.facility !== facility;
        }
        for (const tab of facilityTabs) {
          if (tab.dataset.facility === facility) tab.setAttribute("aria-current", "page");
          else tab.removeAttribute("aria-current");
        }
        selectHallFacility(facility);
      }

      facilityTabs.forEach((tab) => {
        tab.addEventListener("click", () => selectFacility(tab.dataset.facility!));
      });
    </script>

    <script>
      import { mount } from "../lib/hall-view/scene.ts";
      import { activateFacility } from "../lib/hall-view/renderer-host.ts";
      import { onFacilitySelected } from "../lib/hall-view/facility-switch.ts";
      import type { Machine } from "../lib/types.ts";

      // Stage 7 — block tabs: a pure VIEW filter over the existing
      // .hall markup (see that <nav>'s own template-side note). This
      // reads/writes only DOM attributes already rendered server-side —
      // no machine or status data is read here, so this can live
      // entirely alongside the mount() call below rather than needing
      // any bridge to the second script block's applyMachineUpdate()
      // (which remains the only machine-data writer, untouched).
      const blockTabs = document.querySelectorAll<HTMLButtonElement>(".block-tab");
      const hallsByLocation = new Map<string, HTMLElement>(
        Array.from(document.querySelectorAll<HTMLElement>(".hall")).map((hall) => [
          hall.dataset.location!,
          hall,
        ]),
      );

      function selectBlock(location: string): void {
        for (const [loc, hall] of hallsByLocation) hall.hidden = loc !== location;
        for (const tab of blockTabs) {
          if (tab.dataset.location === location) tab.setAttribute("aria-current", "true");
          else tab.removeAttribute("aria-current");
        }
      }

      blockTabs.forEach((tab) => {
        tab.addEventListener("click", () => selectBlock(tab.dataset.location!));
      });

      const container = document.getElementById("hall-view-canvas");
      const section = document.querySelector<HTMLElement>(".hall-view");
      if (container && section) {
        try {
          const machines = JSON.parse(section.dataset.machines!) as Machine[];
          // Stage 6 — the only new behavior mount() is given here: when
          // a machine is focused/unfocused in the 3D view, scroll its
          // matching info-panel card into view and mark it highlighted.
          // Deliberately NOT opening its <details class="report"> —
          // focusing a machine is "look at this one," not "I'm about to
          // report its status," so the report control stays collapsed
          // until the resident explicitly opens it themselves.
          //
          // Stage 7 — also switches the right panel's block tab to the
          // focused machine's own block first, so its card is actually
          // visible (not hidden by a different block's filter) before
          // scrolling/highlighting it. On return to overview
          // (machineId === null), the current block tab is deliberately
          // left as-is — the brief's own "focus exiting can leave the
          // current Block tab unchanged" requirement — only the
          // highlight is cleared.
          const prefersReducedMotion =
            window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
          let highlightedCard: HTMLElement | null = null;
          mount(container, machines, (machineId) => {
            highlightedCard?.classList.remove("machine--highlighted");
            highlightedCard = null;
            if (!machineId) return;
            const card = document.querySelector<HTMLElement>(`.machine[data-machine="${machineId}"]`);
            if (!card) return;
            const hall = card.closest<HTMLElement>(".hall");
            if (hall?.dataset.location) selectBlock(hall.dataset.location);
            card.classList.add("machine--highlighted");
            highlightedCard = card;
            card.scrollIntoView({ block: "nearest", behavior: prefersReducedMotion ? "auto" : "smooth" });
          });
          // Stage 4 — Laundry is already built and active from the
          // mount() call just above (it's the default-visible facility
          // tab), so switching BACK to it never needs a rebuild — only
          // the cheap canvas-reparent + resize activateFacility() already
          // does. The shared renderer/canvas was briefly owned by AA
          // Room's container while that tab was selected; this is what
          // moves it back into Laundry's own container, with Laundry's
          // own camera/framing completely unchanged by that round trip
          // (see renderer-host.ts: activating a facility never rebuilds
          // its scene or camera, only resizes against the now-visible
          // container's real dimensions).
          onFacilitySelected("laundry", () => activateFacility("laundry", container));
        } catch {
          // WebGL unavailable, or anything else went wrong building the
          // scene — the dashboard above and below is a complete
          // experience on its own either way, so this fails silently
          // rather than showing a broken canvas. See Stage 4 in the
          // design notes for a more deliberate fallback treatment.
          container.remove();
          section.querySelector(".hall-view-caption")?.remove();
        }
      }
    </script>

    {/* Stage 4 — AA Room's own 3D mount, a separate script block from
        Laundry's above (each its own module scope), coordinating through
        facility-switch.ts and renderer-host.ts the same way the AA Room
        panel script coordinates with Laundry's dashboard script through
        live-stream.ts. Built LAZILY: mountAaRoom() only runs the first
        time a resident actually selects the AA Room tab (via
        onFacilitySelected below), not eagerly at page load while hidden
        — building a Three.js scene for a container that's display:none
        would read a zero-sized container and, more importantly, would
        immediately steal the one shared canvas away from Laundry's own
        visible container before any resident ever asked for AA Room.
        Every selection after the first is just the same cheap
        activateFacility() reparent Laundry's own re-selection uses. */}
    <script>
      import { mountAaRoom } from "../lib/hall-view/scene.ts";
      import { activateFacility } from "../lib/hall-view/renderer-host.ts";
      import { onFacilitySelected } from "../lib/hall-view/facility-switch.ts";

      interface AaRoomSceneState {
        occupancy: "empty" | "occupied" | "unknown";
        activities: ("tv" | "pool" | "table-tennis" | "hanging-out" | "event")[];
        confirmedAt: number | null;
