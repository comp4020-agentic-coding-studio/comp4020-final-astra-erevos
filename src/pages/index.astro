        minutesInput.disabled = !occupied;
        if (!occupied) minutesInput.value = "";
      }

      if (panel) {
        const initial = JSON.parse(panel.dataset.rabbitRoom!) as RabbitRoomState;
        applyRabbitRoomUpdate(initial);

        for (const radio of occupancyRadios) radio.addEventListener("change", syncMinutesInput);
        syncMinutesInput();

        // A push from ANY session's report or decay transition, over the
        // page's one shared SSE connection. applyRabbitRoomUpdate() only
        // ever writes the display elements and never touches
        // occupancyRadios/minutesInput, so a resident mid-way through
