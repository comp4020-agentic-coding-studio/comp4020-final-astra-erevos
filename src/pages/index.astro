        notes/adr/0005-rabbit-room-live-state.md and
        src/lib/hall-view/rabbit-room.ts. */}
    <script>
      import { mountRabbitRoom } from "../lib/hall-view/scene.ts";
      import { activateFacility } from "../lib/hall-view/renderer-host.ts";
      import { onFacilitySelected } from "../lib/hall-view/facility-switch.ts";

      interface RabbitRoomSceneState {
        occupancy: "empty" | "occupied" | "unknown";
        expectedEndAt: number | null;
        confirmedAt: number | null;
        version: number;
      }

      const rabbitRoomContainer = document.getElementById("rabbit-room-canvas");
      const rabbitRoomSection = rabbitRoomContainer?.closest<HTMLElement>(".hall-view") ?? null;

      if (rabbitRoomContainer && rabbitRoomSection && rabbitRoomSection.dataset.rabbitRoom) {
        let built = false;
        onFacilitySelected("rabbit-room", () => {
          if (built) {
            activateFacility("rabbit-room", rabbitRoomContainer);
            return;
          }
          built = true;
          try {
            const initial = JSON.parse(rabbitRoomSection.dataset.rabbitRoom!) as RabbitRoomSceneState;
            mountRabbitRoom(rabbitRoomContainer, initial);
          } catch {
