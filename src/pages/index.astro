            }),
          });

          if (res.ok) {
            const room = (await res.json()) as RabbitRoomState;
            applyRabbitRoomUpdate(room);
            syncMinutesInput();
            return;
          }

          if (res.status === 409) {
            // Same conflict UX as every other facility's report script:
            // say so plainly, show the state the server actually holds,
            // let the resident decide whether to report again — never a
            // silent overwrite, never a silent reload.
            const { current } = await res.json();
            applyRabbitRoomUpdate(current as RabbitRoomState);
            syncMinutesInput();
            const label = STATUS_META[(current as RabbitRoomState).occupancy]?.label ?? (current as RabbitRoomState).occupancy;
            alert(
              `Rabbit Room changed since you last saw it — it's now reported as "${label}". ` +
                "The panel shows that now; check it and report again if it's still wrong.",
            );
