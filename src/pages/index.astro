---
import { LOCATIONS, listMachines, type Machine, type MachineStatus, type MachineType } from "../lib/db.ts";
import {
  COOKIE_NAME,
  COOKIE_MAX_AGE_SECONDS,
  createSession,
  isHttpsRequest,
  resolveSession,
} from "../lib/sessions.ts";
import { logSessionCreated } from "../lib/log.ts";

// Crit 10: resolve this browser's session from its cookie, or create a
// new one on first visit — page loads are the one place creation
// happens; API routes only ever resolve (see
// src/pages/api/machines/[id].ts) and reject rather than mint a new
// identity for a write they're about to refuse anyway. See
// notes/adr/0002-identity-and-permissions.md.
let session = resolveSession(Astro.cookies.get(COOKIE_NAME)?.value);
if (!session) {
  const created = createSession();
  session = created.session;
  logSessionCreated(session.pseudonym);
  // Secure only over HTTPS — see isHttpsRequest() in
  // src/lib/request-protocol.ts for why this can't be Astro.url.protocol
  // alone: Fly's proxy forwards the request to this process over plain
  // HTTP, so that check alone reads "http:" even on the live HTTPS site.
  Astro.cookies.set(COOKIE_NAME, created.token, {
    httpOnly: true,
    sameSite: "lax",
    path: "/",
    maxAge: COOKIE_MAX_AGE_SECONDS,
    secure: isHttpsRequest(Astro.url, Astro.request.headers.get("x-forwarded-proto")),
  });
}
const pseudonym = session.pseudonym;

const machines = listMachines();
const byLocation = new Map(
  LOCATIONS.map((loc) => [loc, machines.filter((m) => m.location === loc)]),
);

// Stage 1 of the Live Hall View (see PROCESS.md): the A/B room only,
// initialized from this page load's real machine state. Deliberately no
// SSE wiring yet — that's Stage 2. Passed as serialized data the same
// way STATUS_META already is, read once by the client module below.
const hallViewMachines = byLocation.get("A/B")!;

// Status semantics, not just decoration: available/out-of-order carry real
// severity (good/critical, from the fixed status palette). in-use is a
// neutral "occupied" identity, not a warning — nothing's wrong, so it gets
// the categorical blue rather than amber. unknown is an absence of
// information, so it gets no saturated colour at all. Every state also
// carries an icon + text label; colour is never the only signal.
const STATUS_META: Record<MachineStatus, { label: string; icon: string; class: string }> = {
  available: { label: "Available", icon: "✓", class: "status-available" },
  "in-use": { label: "In use", icon: "●", class: "status-in-use" },
  "out-of-order": { label: "Out of order", icon: "✕", class: "status-out-of-order" },
  unknown: { label: "Unknown", icon: "?", class: "status-unknown" },
};

const summary = [
  { key: "available" as const, count: machines.filter((m) => m.status === "available").length },
  { key: "in-use" as const, count: machines.filter((m) => m.status === "in-use").length },
  { key: "out-of-order" as const, count: machines.filter((m) => m.status === "out-of-order").length },
  { key: "unknown" as const, count: machines.filter((m) => m.status === "unknown").length },
];

function confirmedLabel(confirmedAt: number | null): string {
  if (confirmedAt === null) return "never reported";
  const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
  if (minutes < 1) return "confirmed just now";
  return `confirmed ${minutes} min ago`;
}

function remainingLabel(machine: Machine): { text: string; known: boolean } {
  if (machine.expectedEndAt === null) return { text: "remaining time unknown", known: false };
  const minutes = Math.round((machine.expectedEndAt - Date.now()) / 60_000);
  return minutes > 0
    ? { text: `${minutes} min left`, known: true }
    : { text: "should be finishing", known: true };
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Toad Live — laundry</title>
    <style>
      :root {
        color-scheme: light;
        --page: #f6efe1;
        --surface: #fffbf1;
        --surface-alt: #fdf6e6;
        --ink: #2c2115;
        --ink-secondary: #6b5c47;
        --ink-muted: #9c8d76;
        --border: rgba(44, 33, 21, 0.14);
        --accent: #3f6b3f;
        --accent-strong: #2f5233;
        --warm: #c1652f;
        --status-good: #0ca30c;
        --status-in-use: #2a78d6;
        --status-critical: #d03b3b;
        /* fixed, never themed — an industrial hazard-tape pairing, same
           idea as the status colours: deliberately not adapted to light/dark */
        --hazard-dark: #1a1410;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --page: #1c150f;
          --surface: #2a2015;
          --surface-alt: #241b12;
          --ink: #f6ecd9;
          --ink-secondary: #d3c2a3;
          --ink-muted: #9c8d76;
          --border: rgba(246, 236, 217, 0.16);
          --accent: #86b986;
          --accent-strong: #a6d1a6;
          --warm: #e08a4f;
          --status-in-use: #3987e5;
        }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--page);
        color: var(--ink);
        font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
      }

      main {
        max-width: 78rem;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
      }

      header.hero {
        text-align: center;
        padding: 1.5rem 1rem 1rem;
      }
      header.hero h1 {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--accent-strong);
        letter-spacing: -0.01em;
      }
      header.hero p {
        margin: 0.5rem auto 0;
        max-width: 32rem;
        color: var(--ink-secondary);
      }
      header.hero a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: var(--border);
      }
      /* Unobtrusive: present so a resident can tell which browser
         identity they have, not a profile/account affordance to draw
         attention to. */
      .identity {
        margin-top: 0.6rem;
        font-size: 0.78rem;
        color: var(--ink-muted);
      }

      /* --- Live Hall View: a visual layer, never load-bearing for any
         fact — see the aria-hidden note on the section itself. Sized
         generously but capped so it reads as "a window into the Hall,"
         not a full-bleed hero image competing with the dashboard below
         it. --- */
      .hall-view {
        max-width: 44rem;
        margin: 0 auto 1.5rem;
      }
      .hall-view-canvas {
        position: relative; /* anchors the hover/focus overlays below */
        width: 100%;
        aspect-ratio: 16 / 10;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 2px 10px rgba(44, 33, 21, 0.08);
        background: var(--page);
      }
      .hall-view-canvas canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
      }
      .hall-view-caption {
        margin: 0.5rem 0 0;
        text-align: center;
        font-size: 0.78rem;
        color: var(--ink-muted);
      }

      /* --- summary stat row: stays a compact, centred band even though
         the page below it now uses the full desktop width --- */
      .summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
        max-width: 44rem;
        margin: 1.5rem auto 2.5rem;
      }
      @media (max-width: 30rem) {
        .summary { grid-template-columns: repeat(2, 1fr); }
      }
      .stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 0.75rem 0.6rem;
        text-align: center;
      }
      .stat .value {
        display: block;
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
      }
      .stat .label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35em;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        color: var(--ink-secondary);
      }
      .stat .dot {
        width: 0.55em;
        height: 0.55em;
        border-radius: 50%;
        flex: none;
      }
      .stat.available .dot, .stat.available .value { color: var(--status-good); }
      .stat.available .dot { background: var(--status-good); }
      .stat.in-use .dot { background: var(--status-in-use); }
      .stat.out-of-order .dot, .stat.out-of-order .value { color: var(--status-critical); }
      .stat.out-of-order .dot { background: var(--status-critical); }
      .stat.unknown .dot { background: var(--ink-muted); }

      /* --- zones: a Block is a location label, not another card. Flex +
         justify-content:center rather than grid so a trailing row of two
         (a 3+2 layout across five blocks) sits centred as a balanced group
         instead of stretching or reading as a "missing" third card. --- */
      .halls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem 1.5rem;
      }
      .hall {
        flex: 1 1 21rem;
        max-width: 24rem;
      }
      @media (max-width: 26rem) {
        .hall { flex-basis: 100%; max-width: none; }
      }
      .zone-label {
        display: flex;
        align-items: center;
        gap: 0.4em;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-strong);
        padding-bottom: 0.5rem;
        margin-bottom: 0.75rem;
        border-bottom: 2px solid var(--border);
      }
      .zone-label svg { flex: none; }
      .machines {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      /* --- the machine card: the one actual "card" in the hierarchy --- */
      .machine {
        position: relative;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 0.8rem 0.9rem;
        box-shadow: 0 1px 2px rgba(44, 33, 21, 0.05);
      }
      .machine-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .machine-icon-chip {
        flex: none;
        width: 2.2rem;
        height: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--surface-alt);
        color: var(--accent-strong);
      }
      .machine-type {
        font-weight: 600;
        text-transform: capitalize;
        margin-right: auto;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        border-radius: 999px;
        padding: 0.2em 0.7em;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid transparent;
      }
      .status-available.badge {
        background: color-mix(in srgb, var(--status-good) 16%, var(--surface));
        color: var(--status-good);
        border-color: color-mix(in srgb, var(--status-good) 35%, transparent);
      }
      .status-in-use.badge {
        background: color-mix(in srgb, var(--status-in-use) 16%, var(--surface));
        color: var(--status-in-use);
        border-color: color-mix(in srgb, var(--status-in-use) 35%, transparent);
      }
      .status-unknown.badge {
        background: transparent;
        color: var(--ink-muted);
        border-color: var(--border);
        border-style: dashed;
      }
      /* out-of-order reads as a stamped notice, not a soft pill — same
         badge family (icon + label + shape) but solid, blocky, uppercase */
      .status-out-of-order.badge {
        background: var(--status-critical);
        color: var(--surface);
        border-color: transparent;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 800;
      }

      /* the broken-machine card also gets a hazard-tape top edge, evoking
         the physical "OUT OF ORDER" notices staff actually tape to these
         machines — fixed colours, deliberately not themed, same as the
         status palette itself */
      .machine--broken {
        border-color: color-mix(in srgb, var(--status-critical) 45%, var(--border));
      }
      .machine--broken::before {
        content: "";
        position: absolute;
        top: -1px;
        left: -1px;
        right: -1px;
        height: 8px;
        border-radius: 13px 13px 0 0;
        background: repeating-linear-gradient(
          45deg,
          var(--status-critical) 0 10px,
          var(--hazard-dark) 10px 20px
        );
      }
      .machine--broken .machine-head { margin-top: 0.15rem; }

      .remaining {
        margin: 0.5rem 0 0;
        font-size: 1.15rem;
        font-weight: 700;
      }
      .remaining.unknown-time {
        font-size: 0.95rem;
        font-weight: 500;
        font-style: italic;
        color: var(--ink-muted);
      }
      .confirmed {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        color: var(--ink-muted);
      }

      /* --- reporting: a small chip, clearly tappable, still secondary --- */
      details.report {
        margin-top: 0.65rem;
      }
      details.report summary {
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--accent-strong);
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        list-style: none;
        min-height: 1.6rem;
      }
      details.report summary::-webkit-details-marker { display: none; }
      details.report summary::before { content: "✎"; font-size: 0.85em; }
      details.report summary::after {
        content: "⌄";
        margin-left: 0.15em;
        transition: transform 0.15s ease;
      }
      details.report[open] summary::after { transform: rotate(180deg); }
      details.report summary:hover {
        background: color-mix(in srgb, var(--accent) 14%, var(--surface-alt));
      }
      details.report summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      form.report-form {
        margin-top: 0.5rem;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      form.report-form select,
      form.report-form input,
      form.report-form button {
        font: inherit;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.5rem 0.6rem;
        background: var(--surface);
        color: var(--ink);
      }
      form.report-form input {
        width: 9rem;
      }
      form.report-form button {
        background: var(--accent);
        color: var(--surface);
        border-color: var(--accent);
        font-weight: 600;
        cursor: pointer;
      }
      form.report-form button:hover { background: var(--accent-strong); }
      form.report-form select:focus-visible,
      form.report-form input:focus-visible,
      form.report-form button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
    </style>

    {/* Stage 2's hover/focus overlay cards are created by
        src/lib/hall-view/overlay.ts via document.createElement, not
        written in this template — Astro's automatic per-component CSS
        scoping only tags elements present in the template at build
        time, so a scoped <style> rule here would silently never match
        them (confirmed: the rule compiled fine but
        getComputedStyle(...).position stayed "static", never
        "absolute", on the live card). is:global is the correct,
        deliberate choice for exactly this one case — dynamically
        created DOM — not a workaround to route around scoping
        elsewhere in this file. The one deliberate "cyber/HUD" accent
        in the app — cyan/electric, monospace, small glowing borders —
        kept confined to these two elements and the in-scene
        outline/brackets they echo, never bleeding into the dashboard's
        own warm, soft-edged visual language below. Restrained on
        purpose: a thin glow and a little structure, not a packed
        sci-fi console. */}
    <style is:global>
      .hall-hover-card {
        position: absolute;
        z-index: 2;
        pointer-events: none; /* never intercepts the canvas's own pointer events */
        min-width: 9rem;
        padding: 0.5rem 0.7rem;
        border-radius: 8px;
        background: rgba(28, 21, 15, 0.82);
        border: 1px solid rgba(95, 232, 224, 0.45);
        box-shadow: 0 0 12px rgba(95, 232, 224, 0.25);
        color: #eafffd;
        font-size: 0.78rem;
        line-height: 1.4;
      }
      .hall-hover-card__name {
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      .hall-hover-card__meta {
        color: #9fd8d3;
        font-size: 0.72rem;
      }
      .hall-status--available { color: #6fe08a; }
      .hall-status--in-use { color: #6fc6ff; }
      .hall-status--out-of-order { color: #ff8a8a; }
      .hall-status--unknown { color: #a8a0ff; opacity: 0.75; }

      /* Stage 2.2: left/top are computed entirely in JS
         (overlay.ts's positionFocusPanel) as the panel's literal
         top-left corner in container-space pixels, already accounting
         for the stem's length and clamped to stay fully on-screen — no
         CSS transform is applied (overlay.ts explicitly sets
         `transform: none`), so there's nothing here for a transform to
         conflict with. --hall-stem-length is set once from JS, in real
         pixels, and read by both overlay.ts's clamp math and the
         ::after stem below, so the two can never drift out of sync the
         way a separately-guessed CSS px value could. */
      .hall-focus-panel {
        --hall-stem-length: 10px;
        position: absolute;
        z-index: 3;
        width: 11.5rem;
        padding: 0.7rem 0.8rem 0.6rem;
        border-radius: 10px;
        background: rgba(20, 16, 12, 0.88);
        border: 1px solid rgba(95, 232, 224, 0.55);
        box-shadow: 0 0 18px rgba(95, 232, 224, 0.3);
        color: #eafffd;
        font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      }
      /* The connecting "stem" — a short vertical line from the panel's
         bottom edge down to the anchor point, making the two visually
         one instrument rather than two unrelated floating pieces. */
      .hall-focus-panel::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: calc(-1 * var(--hall-stem-length));
        width: 1px;
        height: var(--hall-stem-length);
        background: rgba(95, 232, 224, 0.6);
      }
      .hall-focus-panel__close {
        position: absolute;
        top: 0.4rem;
        right: 0.5rem;
        background: none;
        border: none;
        color: #9fd8d3;
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
        padding: 0.1rem 0.3rem;
      }
      .hall-focus-panel__close:hover { color: #eafffd; }
      .hall-focus-panel__header {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        margin-bottom: 0.5rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid rgba(95, 232, 224, 0.3);
      }
      .hall-focus-panel__name {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .hall-focus-panel__status {
        font-size: 0.72rem;
        font-weight: 600;
      }
      .hall-focus-panel__facts {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.2rem 0.5rem;
        margin: 0;
        font-size: 0.72rem;
      }
      .hall-focus-panel__facts dt {
        color: #9fd8d3;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 0.65rem;
      }
      .hall-focus-panel__facts dd {
        margin: 0;
        text-align: right;
      }
    </style>
  </head>
  <body data-status-meta={JSON.stringify(STATUS_META)}>
    <main>
      <header class="hero">
        <h1>Toad Live</h1>
        <p>
          Laundry across Toad Hall's five blocks — reported by residents, not
          sensors. See <a href="/readme/">what "good" means here</a>.
        </p>
        <p class="identity">You're reporting as <strong>{pseudonym}</strong></p>
      </header>

      {/* Live Hall View — Stage 1: A/B room only, a visual layer above
          the dashboard, never a replacement for it. aria-hidden because
          every fact it shows is already stated as accessible text below;
          a screen-reader user loses nothing by this section being
          skipped entirely. No SSE wiring yet (Stage 2) — initialized
          once from this page load's real state via data-machines. */}
      <section
        class="hall-view"
        aria-hidden="true"
        data-machines={JSON.stringify(hallViewMachines)}
      >
        <div class="hall-view-canvas" id="hall-view-canvas"></div>
        <p class="hall-view-caption">A/B laundry room — live, Stage 1 preview</p>
      </section>

      <section class="summary" aria-label="Laundry summary">
        {summary.map(({ key, count }) => (
          <div class:list={["stat", key]}>
            <span class="value">{count}</span>
            <span class="label"><span class="dot"></span>{STATUS_META[key].label.toLowerCase()}</span>
          </div>
        ))}
      </section>

      <section class="halls">
        {LOCATIONS.map((location) => (
          <article class="hall">
            <h2 class="zone-label">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-6.5-5.8-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.2-6.5 11-6.5 11z" />
                <circle cx="12" cy="10" r="2.2" />
              </svg>
              Block {location}
            </h2>
            <div class="machines">
              {byLocation.get(location)!.map((machine) => {
                const meta = STATUS_META[machine.status];
                const remaining = machine.status === "in-use" ? remainingLabel(machine) : null;
                const broken = machine.status === "out-of-order";
                return (
                  <div
                    class:list={["machine", broken && "machine--broken"]}
                    data-machine={machine.id}
                    data-status={machine.status}
                  >
                    <div class="machine-head">
                      <span class="machine-icon-chip" aria-hidden="true">
                        {machine.type === "washer" ? (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="2.5" width="18" height="19" rx="3" />
                            <circle cx="12" cy="13" r="6" />
                            <path d="M9 13c.8-1 1.5-1 2 0s1.2 1 2 0" />
                            <circle cx="6.5" cy="5.5" r="0.6" fill="currentColor" stroke="none" />
                            <circle cx="9" cy="5.5" r="0.6" fill="currentColor" stroke="none" />
                          </svg>
                        ) : (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="2.5" width="18" height="19" rx="3" />
                            <circle cx="12" cy="13" r="6" />
                            <path d="M9.5 15.3a3.2 3.2 0 0 1 4.6-4" />
                            <path d="M14.5 10.7a3.2 3.2 0 0 1-4.6 4" />
                            <line x1="6.5" y1="5.5" x2="9" y2="5.5" />
                          </svg>
                        )}
                      </span>
                      <span class="machine-type">{machine.type}</span>
                      <span class:list={["badge", meta.class]}>
                        <span aria-hidden="true">{meta.icon}</span>{meta.label}
                      </span>
                    </div>

                    {/* Always rendered, hidden when not in-use, so a live
                        update has a stable node to toggle rather than
                        needing to build this element from scratch in JS. */}
                    <p
                      class:list={["remaining", remaining && !remaining.known && "unknown-time"]}
                      hidden={!remaining}
                    >
                      {remaining ? remaining.text : ""}
                    </p>
                    <span class="confirmed">{confirmedLabel(machine.confirmedAt)}</span>

                    <details class="report">
                      <summary>Update status</summary>
                      <form class="report-form" data-id={machine.id} data-version={machine.version}>
                        <select name="status" aria-label={`New status for ${location} ${machine.type}`}>
                          <option value="available">Available</option>
                          <option value="in-use">In use</option>
                          <option value="out-of-order">Out of order</option>
                        </select>
                        <input
                          type="number"
                          name="minutes"
                          min="0"
                          placeholder="minutes left (optional)"
                          aria-label="Minutes remaining, optional"
                        />
                        <button type="submit">Report</button>
                      </form>
                    </details>
                  </div>
                );
              })}
            </div>
          </article>
        ))}
      </section>
    </main>

    {/* Live Hall View mount — its own inline <script> block, still
        touching only #hall-view-canvas, never the dashboard markup.
        Stage 2.3: the dashboard's own script (next) now imports
        applyMachineToScene from this same scene.ts module to feed it
        live updates — see that import's own note on how two separate
        inline <script> blocks share one module instance. Nothing here
        changes: this block still only mounts the scene from the
        page's initial state; it's the *other* script that reaches
        into this module now, not this one reaching out. */}
    <script>
      import { mount } from "../lib/hall-view/scene.ts";
      import type { Machine } from "../lib/types.ts";

      const container = document.getElementById("hall-view-canvas");
      const section = document.querySelector<HTMLElement>(".hall-view");
      if (container && section) {
        try {
          const machines = JSON.parse(section.dataset.machines!) as Machine[];
          mount(container, machines);
        } catch {
          // WebGL unavailable, or anything else went wrong building the
          // scene — the dashboard above and below is a complete
          // experience on its own either way, so this fails silently
          // rather than showing a broken canvas. See Stage 4 in the
          // design notes for a more deliberate fallback treatment.
          container.remove();
          section.querySelector(".hall-view-caption")?.remove();
        }
      }
    </script>

    <script>
      // Stage 2.3: the 3D hall view's only hook into live updates — see
      // scene.ts's own note on why importing this here, from a second,
      // separate inline <script> block, still reaches the same module
      // instance mount() runs in (ES modules are singletons keyed by
      // URL; both scripts import the same file).
      import { applyMachineToScene } from "../lib/hall-view/scene.ts";
      import type { Machine } from "../lib/types.ts";

      // Server-rendered badge text/icon/class (STATUS_META in the
      // frontmatter above), read once rather than re-derived here, so a
      // live update can never drift from what a fresh page load would show.
      const STATUS_META = JSON.parse(document.body.dataset.statusMeta!) as Record<
        string,
        { label: string; icon: string; class: string }
      >;

      // The server's actual GET/PATCH/SSE payloads are the full Machine
      // shape (src/lib/types.ts) — this was previously its own narrower
      // local interface (id/status/expectedEndAt/confirmedAt/version
      // only, with status typed as a loose string) that happened to
      // cover what the dashboard card needed. Widened to the real
      // Machine type so the exact same payload can also be handed to
      // applyMachineToScene() below without a cast or a second parse.
      type MachineUpdate = Machine;

      // Mirrors confirmedLabel()/remainingLabel() in the frontmatter above.
      // Both need the *client's* current clock, so they can't be shared
      // directly across the server/client boundary — kept tiny and
      // behaviourally identical instead of invented differently here.
      function confirmedLabel(confirmedAt: number | null): string {
        if (confirmedAt === null) return "never reported";
        const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
        if (minutes < 1) return "confirmed just now";
        return `confirmed ${minutes} min ago`;
      }

      function remainingLabel(expectedEndAt: number | null): { text: string; known: boolean } {
        if (expectedEndAt === null) return { text: "remaining time unknown", known: false };
        const minutes = Math.round((expectedEndAt - Date.now()) / 60_000);
        return minutes > 0
          ? { text: `${minutes} min left`, known: true }
          : { text: "should be finishing", known: true };
      }

      // One status per visible machine, kept in sync with every incoming
      // update so the summary row never needs a full-page recount.
      const statusByMachine = new Map<string, string>(
        Array.from(document.querySelectorAll<HTMLElement>(".machine")).map((el) => [
          el.dataset.machine!,
          el.dataset.status!,
        ]),
      );

      function updateSummary(): void {
        const counts: Record<string, number> = { available: 0, "in-use": 0, "out-of-order": 0, unknown: 0 };
        for (const status of statusByMachine.values()) counts[status] = (counts[status] ?? 0) + 1;
        for (const [key, count] of Object.entries(counts)) {
          const el = document.querySelector(`.stat.${key} .value`);
          if (el) el.textContent = String(count);
        }
      }

      // Applies one machine's canonical state to its card — used for a
      // live push, for the current state a 409 conflict hands back, and
      // for the re-fetch a (re)connected EventSource triggers below. Never
      // reloads the page: this *is* "without a reload."
      //
      // Stage 2.3: also the Hall View's only subscriber to this same
      // canonical path (see applyMachineToScene's own note in scene.ts).
      // Called unconditionally, before the dashboard-card early return
      // below, since it's an orthogonal concern: applyMachineToScene()
      // already no-ops for any machine id it has no mesh for (today,
      // anything outside the A/B room), the same way this function's
      // own card lookup no-ops for an id it finds no card for.
      function applyMachineUpdate(machine: MachineUpdate): void {
        applyMachineToScene(machine);

        const card = document.querySelector<HTMLElement>(`.machine[data-machine="${machine.id}"]`);
        if (!card) return;

        card.dataset.status = machine.status;
        card.classList.toggle("machine--broken", machine.status === "out-of-order");

        const meta = STATUS_META[machine.status];
        const badge = card.querySelector(".badge");
        if (badge && meta) {
          badge.className = `badge ${meta.class}`;
          badge.innerHTML = `<span aria-hidden="true">${meta.icon}</span>${meta.label}`;
        }

        const remainingEl = card.querySelector<HTMLElement>(".remaining");
        if (remainingEl) {
          if (machine.status === "in-use") {
            const remaining = remainingLabel(machine.expectedEndAt);
            remainingEl.hidden = false;
            remainingEl.classList.toggle("unknown-time", !remaining.known);
            remainingEl.textContent = remaining.text;
          } else {
            remainingEl.hidden = true;
          }
        }

        const confirmedEl = card.querySelector(".confirmed");
        if (confirmedEl) confirmedEl.textContent = confirmedLabel(machine.confirmedAt);

        // The next PATCH from this card must match the version it just
        // saw, not the one the page was originally rendered with.
        const form = card.querySelector<HTMLFormElement>(".report-form");
        if (form) form.dataset.version = String(machine.version);

        statusByMachine.set(machine.id, machine.status);
        updateSummary();
      }

      // One SSE connection for the whole page. No event replay/history: a
      // (re)connection just re-fetches current state for every card below,
      // the same read path any page load already uses — see
      // notes/adr/0001-realtime-and-concurrent-updates.md.
      const events = new EventSource("/api/stream");

      events.addEventListener("machine", (event) => {
        applyMachineUpdate(JSON.parse((event as MessageEvent<string>).data));
      });

      events.addEventListener("open", () => {
        const ids = Array.from(document.querySelectorAll<HTMLElement>(".machine")).map(
          (el) => el.dataset.machine!,
        );
        Promise.all(
          ids.map((id) => fetch(`/api/machines/${id}`).then((res) => res.json() as Promise<MachineUpdate>)),
        ).then((machines) => machines.forEach(applyMachineUpdate));
      });

      document.querySelectorAll<HTMLFormElement>(".report-form").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const id = form.dataset.id;
          const ifVersion = Number(form.dataset.version);
          const status = (form.elements.namedItem("status") as HTMLSelectElement).value;
          const minutesRaw = (form.elements.namedItem("minutes") as HTMLInputElement).value;
          const minutes = minutesRaw === "" ? null : Number(minutesRaw);

          // No reporterId here — the actor is resolved server-side from
          // this browser's session cookie (see
          // notes/adr/0002-identity-and-permissions.md); the cookie is
          // sent automatically with same-origin fetch, nothing to attach
          // client-side.
          const res = await fetch(`/api/machines/${id}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              status,
              ifVersion,
              expectedEndAt:
                status === "in-use" && minutes !== null ? Date.now() + minutes * 60_000 : undefined,
            }),
          });

          if (res.ok) {
            // This session's own open SSE connection receives the same
            // broadcast every other open session does, so the card updates
            // itself the normal way — nothing left to do but tidy the form.
            const details = form.closest("details.report");
            if (details) (details as HTMLDetailsElement).open = false;
            return;
          }

          if (res.status === 409) {
            // Someone else's report, or a lazy decay, landed since this
            // card was rendered. Say so plainly, show the state the server
            // actually holds, and let the resident decide whether to
            // report again — never a silent overwrite and never a silent
            // reload either.
            const { current } = await res.json();
            applyMachineUpdate(current);
            const label = STATUS_META[current.status]?.label ?? current.status;
            alert(
              `This machine changed since you last saw it — it's now reported as "${label}". ` +
                "The card shows that now; check it and report again if it's still wrong.",
            );
            return;
          }

          alert("couldn't save that report — try again");
        });
      });
    </script>
  </body>
</html>
