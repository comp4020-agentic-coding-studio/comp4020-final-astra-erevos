          return;
        }

        const meta = STATUS_META[room.occupancy];
        statusEl.className = `rabbit-room-status ${meta.class}`;
        statusIconEl.textContent = meta.icon;
        statusLabelEl.textContent = meta.label;

        if (room.occupancy === "occupied") {
          const remaining = remainingLabel(room.expectedEndAt);
          remainingEl.hidden = false;
          remainingEl.classList.toggle("unknown-time", !remaining.known);
          remainingEl.textContent = remaining.text;
        } else {
          remainingEl.hidden = true;
          remainingEl.textContent = "";
        }

        confirmedEl.textContent = confirmedLabel(room.confirmedAt);

        form.dataset.version = String(room.version);
      }

      // Disables (and clears) the minutes input whenever occupancy isn't
      // "occupied" — the direct guarantee that an Empty report never
      // carries a leftover estimate (ADR 0005, Decision 2: expectedEndAt
      // is per-observation, never inherited). Recomputed from the full
      // current selection every time anything changes, same discipline
      // Otter Room's own syncMinutesInput() uses.
      function syncMinutesInput(): void {
        if (!minutesInput) return;
