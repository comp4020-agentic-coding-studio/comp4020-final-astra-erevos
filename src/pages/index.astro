      const panel = document.querySelector<HTMLElement>(".rabbit-room-panel");
      const statusEl = panel?.querySelector<HTMLElement>(".rabbit-room-status");
      const statusIconEl = panel?.querySelector<HTMLElement>(".rabbit-room-status-icon");
      const statusLabelEl = panel?.querySelector<HTMLElement>(".rabbit-room-status-label");
      const remainingEl = panel?.querySelector<HTMLElement>(".rabbit-room-remaining");
      const confirmedEl = panel?.querySelector<HTMLElement>(".rabbit-room-confirmed");
      const form = panel?.querySelector<HTMLFormElement>(".rabbit-room-report-form");
      const occupancyRadios = form
        ? Array.from(form.querySelectorAll<HTMLInputElement>('input[name="occupancy"]'))
        : [];
      const minutesInput = form?.querySelector<HTMLInputElement>('input[name="minutes"]') ?? null;
      function occupancyValue(): string | undefined {
        return occupancyRadios.find((r) => r.checked)?.value;
      }

      // Applies Rabbit Room's canonical state to the panel — used for the
      // initial server-rendered state (called once below), this
      // browser's own PATCH response (success or 409 conflict alike),
      // and any other session's push over SSE. Mirrors Otter Room's
      // applyOtterRoomUpdate(): one canonical update path, never a second
      // client-side state model to drift from the server's.
