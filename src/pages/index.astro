---
import { LOCATIONS, listMachines, type Machine, type MachineStatus, type MachineType } from "../lib/db.ts";
import { getAaRoom } from "../lib/aa-room.ts";
import type { AaRoomActivity, AaRoomOccupancy } from "../lib/types.ts";
import {
  COOKIE_NAME,
  COOKIE_MAX_AGE_SECONDS,
  createSession,
  isHttpsRequest,
  resolveSession,
} from "../lib/sessions.ts";
import { logSessionCreated } from "../lib/log.ts";

// Crit 10: resolve this browser's session from its cookie, or create a
// new one on first visit — page loads are the one place creation
// happens; API routes only ever resolve (see
// src/pages/api/machines/[id].ts) and reject rather than mint a new
// identity for a write they're about to refuse anyway. See
// notes/adr/0002-identity-and-permissions.md.
let session = resolveSession(Astro.cookies.get(COOKIE_NAME)?.value);
if (!session) {
  const created = createSession();
  session = created.session;
  logSessionCreated(session.pseudonym);
  // Secure only over HTTPS — see isHttpsRequest() in
  // src/lib/request-protocol.ts for why this can't be Astro.url.protocol
  // alone: Fly's proxy forwards the request to this process over plain
  // HTTP, so that check alone reads "http:" even on the live HTTPS site.
  Astro.cookies.set(COOKIE_NAME, created.token, {
    httpOnly: true,
    sameSite: "lax",
    path: "/",
    maxAge: COOKIE_MAX_AGE_SECONDS,
    secure: isHttpsRequest(Astro.url, Astro.request.headers.get("x-forwarded-proto")),
  });
}
const pseudonym = session.pseudonym;

const machines = listMachines();
const byLocation = new Map(
  LOCATIONS.map((loc) => [loc, machines.filter((m) => m.location === loc)]),
);

// Stage 2 (AA Room): no SSE yet — this is a plain page-load read of the
// one canonical row, the same way `machines` above is. The panel below
// renders directly from this; nothing here invents a second client-side
// state model to keep in sync with it. See
// notes/adr/0003-aa-room-live-state.md.
const aaRoom = getAaRoom();

// Stage 1 of the Live Hall View (see PROCESS.md): initialized from this
// page load's real machine state. Deliberately no SSE wiring yet at
// Stage 1 — that was Stage 2. Stage 3: all five real locations, not just
// A/B — scene.ts places each at its own hall-layout.ts offset. Passed as
// serialized data the same way STATUS_META already is, read once by the
// client module below.
const hallViewMachines = machines;

// Status semantics, not just decoration: available/out-of-order carry real
// severity (good/critical, from the fixed status palette). in-use is a
// neutral "occupied" identity, not a warning — nothing's wrong, so it gets
// the categorical blue rather than amber. unknown is an absence of
// information, so it gets no saturated colour at all. Every state also
// carries an icon + text label; colour is never the only signal.
const STATUS_META: Record<MachineStatus, { label: string; icon: string; class: string }> = {
  available: { label: "Available", icon: "✓", class: "status-available" },
  "in-use": { label: "In use", icon: "●", class: "status-in-use" },
  "out-of-order": { label: "Out of order", icon: "✕", class: "status-out-of-order" },
  unknown: { label: "Unknown", icon: "?", class: "status-unknown" },
};

const summary = [
  { key: "available" as const, count: machines.filter((m) => m.status === "available").length },
  { key: "in-use" as const, count: machines.filter((m) => m.status === "in-use").length },
  { key: "out-of-order" as const, count: machines.filter((m) => m.status === "out-of-order").length },
  { key: "unknown" as const, count: machines.filter((m) => m.status === "unknown").length },
];

// AA Room's own status palette — occupied reads as the "something to see
// here" state (categorical blue, same identity as Laundry's in-use: a
// fact, not a warning), empty is good/available-coded, unknown is the
// same no-saturated-colour absence-of-information treatment as Laundry's
// unknown. See notes/adr/0003-aa-room-live-state.md, Decision 2 — this is
// occupancy's full value set; activity is a separate, optional label
// layered on top, not a second status to colour.
const AA_ROOM_STATUS_META: Record<AaRoomOccupancy, { label: string; icon: string; class: string }> = {
  empty: { label: "Empty", icon: "✓", class: "status-available" },
  occupied: { label: "Occupied", icon: "●", class: "status-in-use" },
  unknown: { label: "Unknown", icon: "?", class: "status-unknown" },
};

const AA_ROOM_ACTIVITY_META: Record<AaRoomActivity, { label: string }> = {
  tv: { label: "TV" },
  pool: { label: "Pool" },
  "table-tennis": { label: "Table tennis" },
  event: { label: "Event" },
};

// Mirrors confirmedLabel() above exactly — a separate copy, not a shared
// function, since the two facilities' underlying rows are different
// shapes (Machine vs AaRoomState) and nothing is gained by forcing one
// function to accept either.
function aaRoomConfirmedLabel(confirmedAt: number | null): string {
  if (confirmedAt === null) return "never reported";
  const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
  if (minutes < 1) return "confirmed just now";
  return `confirmed ${minutes} min ago`;
}

// Freshness is its own line, deliberately separate from the occupancy
// badge — see the ADR, Decision 3: "stale" is a presentation-only
// judgment about an otherwise-unchanged occupancy value, and "no fresh
// observation" (freshness === null) is itself worth saying plainly rather
// than only implied by occupancy already reading "Unknown".
function aaRoomFreshnessLabel(freshness: "fresh" | "stale" | null): { text: string; class: string } | null {
  if (freshness === "fresh") return null; // fresh needs no extra caveat — confirmedLabel alone is enough
  if (freshness === "stale") {
    return { text: "this may be out of date", class: "aa-freshness--stale" };
  }
  return { text: "no recent enough report to show", class: "aa-freshness--unknown" };
}

function confirmedLabel(confirmedAt: number | null): string {
  if (confirmedAt === null) return "never reported";
  const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
  if (minutes < 1) return "confirmed just now";
  return `confirmed ${minutes} min ago`;
}

function remainingLabel(machine: Machine): { text: string; known: boolean } {
  if (machine.expectedEndAt === null) return { text: "remaining time unknown", known: false };
  const minutes = Math.round((machine.expectedEndAt - Date.now()) / 60_000);
  return minutes > 0
    ? { text: `${minutes} min left`, known: true }
    : { text: "should be finishing", known: true };
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Toad Live — laundry</title>
    {/* Stage 4 — fixes the real /favicon.ico 404 that showed up in every
        console check this session. A plain static SVG (no build step, no
        new dependency): a washer porthole in the app's own ink/moss-green
        palette, not a generic placeholder. public/favicon.ico is the
        exact same file content at that exact path, for browsers that
        request /favicon.ico directly rather than reading this tag — most
        browsers don't validate file-extension-vs-content for a favicon,
        confirmed via a real request against this dev server. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        color-scheme: light;
        --page: #f6efe1;
        --surface: #fffbf1;
        --surface-alt: #fdf6e6;
        --ink: #2c2115;
        --ink-secondary: #6b5c47;
        --ink-muted: #9c8d76;
        --border: rgba(44, 33, 21, 0.14);
        --accent: #3f6b3f;
        --accent-strong: #2f5233;
        --warm: #c1652f;
        --status-good: #0ca30c;
        --status-in-use: #2a78d6;
        --status-critical: #d03b3b;
        /* fixed, never themed — an industrial hazard-tape pairing, same
           idea as the status colours: deliberately not adapted to light/dark */
        --hazard-dark: #1a1410;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --page: #1c150f;
          --surface: #2a2015;
          --surface-alt: #241b12;
          --ink: #f6ecd9;
          --ink-secondary: #d3c2a3;
          --ink-muted: #9c8d76;
          --border: rgba(246, 236, 217, 0.16);
          --accent: #86b986;
          --accent-strong: #a6d1a6;
          --warm: #e08a4f;
          --status-in-use: #3987e5;
        }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--page);
        color: var(--ink);
        font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
      }

      main {
        max-width: 100rem;
        margin: 0 auto;
        padding: 1.25rem 1.25rem 1.5rem;
      }

      /* Stage 6 — the desktop workbench layout: header/tabs stay their
         natural height, the workbench (hall-view-pane + info-panel)
         takes up the rest of the viewport and scrolls internally rather
         than letting the whole page scroll. Below 64rem (tablet/phone)
         this is skipped entirely — main just flows normally, exactly as
         it always has, which is the deliberate "mobile fallback is the
         existing single-column layout" decision carried over from the
         Stage 3 five-room-layout planning. */
      @media (min-width: 64rem) {
        main {
          /* height, not min-height: this has to be a hard CAP so the
             flex/grid chain below (.workbench -> .hall-view-pane/
             .info-panel -> .halls) is actually constrained and .halls
             becomes the thing that scrolls — a min-height lets main
             grow to fit its content instead, which defeats the whole
             "page doesn't scroll" goal (confirmed: with min-height,
             .halls's scrollHeight === clientHeight, i.e. nothing was
             actually being clipped). */
          height: 100dvh;
          display: flex;
          flex-direction: column;
          overflow: hidden;
        }
      }

      header.hero {
        text-align: center;
        padding: 1.5rem 1rem 1rem;
        flex: none;
      }
      @media (min-width: 64rem) {
        header.hero { padding: 0.75rem 1rem 0.5rem; }
      }
      header.hero h1 {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--accent-strong);
        letter-spacing: -0.01em;
      }
      header.hero p {
        margin: 0.5rem auto 0;
        max-width: 32rem;
        color: var(--ink-secondary);
      }
      header.hero a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: var(--border);
      }
      /* Unobtrusive: present so a resident can tell which browser
         identity they have, not a profile/account affordance to draw
         attention to. */
      .identity {
        margin-top: 0.6rem;
        font-size: 0.78rem;
        color: var(--ink-muted);
      }

      /* --- Stage 6: facility tabs — Toad Live's original concept was
         every shared space in Toad Hall, not laundry specifically.
         Laundry and (Stage 2) AA Room are real, data-backed tabs; the
         other five are visible so the eventual shape of the app is
         legible, but are inert — no route, no placeholder page, no
         invented data. Plain <button disabled> for those (not a
         styled-to-look-clickable link to nowhere), so assistive tech and
         a mouse both get an honest "not available yet" signal for free.
         The two real tabs are plain, clickable, non-disabled buttons —
         cursor:pointer below overrides the default cursor:default only
         for them. --- */
      .facility-tabs {
        flex: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem;
        padding: 0 1rem 0.75rem;
      }
      .facility-tab {
        font: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-secondary);
        cursor: default;
      }
      .facility-tab[data-facility] {
        cursor: pointer;
      }
      /* Inactive-hover: light surface + the existing dark ink-secondary
         text this tab already has outside hover — never touches `color`
         at all, so there's nothing for it to get wrong. */
      .facility-tab[data-facility]:not([aria-current="page"]):hover {
        background: var(--surface-alt);
      }
      .facility-tab:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      .facility-tab[aria-current="page"] {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--surface);
        cursor: pointer;
      }
      /* Active-hover: a real browser check found the OLD unconditional
         `[data-facility]:hover { background: var(--surface-alt) }` rule
         (specificity (0,3,0), beating [aria-current="page"]'s (0,2,0) on
         background alone) could win against this very rule while never
         touching `color` — leaving aria-current's white text sitting on
         the hover rule's near-white background: white-on-white,
         functionally invisible. Fixed two ways together, not just one:
         the inactive-hover rule above now explicitly excludes
         [aria-current="page"] so it can never apply here regardless of
         specificity, AND this rule gives the active tab its own explicit
         hover treatment (a darker green, not a lighter one, since its
         text is already white) so hovering the currently-active tab has
         a correct, deliberate look rather than depending on no other
         rule ever reaching it. */
      .facility-tab[aria-current="page"]:hover {
        background: var(--accent-strong);
        border-color: var(--accent-strong);
      }
      .facility-tab:disabled {
        color: var(--ink-muted);
        opacity: 0.55;
        cursor: not-allowed;
      }

      /* --- Stage 6: the 70/30 desktop workbench — left column is the
         enlarged Hall View, right column is the relocated (not
         rebuilt — see index.astro's own top-of-file note) summary +
         machine list. minmax() on the right column's fr keeps it from
         being crushed unreadable on a narrower desktop width, rather
         than a literal 70%/30% split. Below 64rem this entire grid
         collapses to a single flowing column (hall-view-pane, then
         info-panel, in source order) — the EXACT markup/CSS the page
         already had before Stage 6, now reached via a media query
         instead of being the only layout. --- */
      .workbench {
        flex: none;
      }
      @media (min-width: 64rem) {
        .workbench {
          flex: 1 1 auto;
          min-height: 0; /* lets the grid children's own min-height:0 rule actually apply, in a flex parent */
          display: grid;
          grid-template-columns: minmax(0, 7fr) minmax(320px, 3fr);
          gap: 1.25rem;
          padding: 0 1.25rem 1.25rem;
        }
      }

      .hall-view-pane {
        display: flex;
        flex-direction: column;
        min-height: 0;
      }

      /* Stage 2 (AA Room) — same transparent-flex-wrapper treatment as
         .info-panel > .facility-view above: .hall-view used to be a
         direct flex child of .hall-view-pane, and is now one level
         deeper inside .facility-view[data-facility="laundry"]/["aa-room"].
         Both wrappers get full flex-child sizing so whichever one is
         visible fills .hall-view-pane exactly as .hall-view/
         .aa-room-placeholder already expect to. */
      .hall-view-pane > .facility-view {
        display: flex;
        flex-direction: column;
        min-height: 0;
        flex: 1 1 auto;
      }

      /* --- Live Hall View: a visual layer, never load-bearing for any
         fact — see the aria-hidden note on the section itself. On
         mobile/tablet this keeps its original modest capped size (a
         "window into the Hall," not competing with the info below it);
         on desktop it becomes the page's actual primary area, filling
         essentially all of the left column's available height. --- */
      .hall-view {
        max-width: 44rem;
        margin: 0 auto 1.5rem;
      }
      @media (min-width: 64rem) {
        .hall-view {
          max-width: none;
          margin: 0;
          flex: 1 1 auto;
          min-height: 0;
          display: flex;
          flex-direction: column;
        }
      }
      .hall-view-canvas {
        position: relative; /* anchors the hover/focus overlays below */
        width: 100%;
        aspect-ratio: 16 / 10;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 2px 10px rgba(44, 33, 21, 0.08);
        background: var(--page);
      }
      @media (min-width: 64rem) {
        .hall-view-canvas {
          flex: 1 1 auto;
          min-height: 0;
          /* The 3D view's own fixed isometric camera/zoom is recomputed
             from the container's real aspect ratio on resize (see
             scene.ts's handleResize -> computeOverviewFit) — dropping
             the fixed aspect-ratio here and letting flex give this
             element whatever height is actually available is exactly
             the resize case that path already handles, not a new one. */
          aspect-ratio: auto;
          width: 100%;
          height: auto;
        }
      }
      .hall-view-canvas canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
      }
      .hall-view-caption {
        margin: 0.5rem 0 0;
        text-align: center;
        font-size: 0.78rem;
        color: var(--ink-muted);
        flex: none;
      }

      /* --- Stage 6: the right-hand info panel. On desktop this is a
         flex column of its own: the summary band is `flex: none` (never
         scrolls away) and .halls is the one scrolling region beneath it
         — exactly the "summary pinned, machine list scrolls"
         requirement. On mobile/tablet info-panel has no special
         treatment at all; it's just a plain block in the normal page
         flow, identical to how summary/halls always rendered before
         Stage 6. --- */
      @media (min-width: 64rem) {
        .info-panel {
          display: flex;
          flex-direction: column;
          min-height: 0;
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 16px;
          padding: 1rem;
        }

        /* Stage 2 (AA Room) — info-panel's children used to be .summary
           and .halls directly; they're now wrapped one level deeper in
           .facility-view[data-facility="laundry"] so the facility-tab
           script has one element to toggle [hidden] on. This rule makes
           that wrapper a transparent flex pass-through — same
           flex-direction/min-height as .info-panel itself — so .summary
           (flex:none, pinned) and .halls (flex:1 1 auto, scrolls) still
           get exactly the sizing they had before the wrapper existed.
           Without this, .summary/.halls would be flex *items* of a
           plain-block wrapper instead of flex children of .info-panel,
           and .halls's own "scroll inside a capped height" rule would
           have nothing to size against. */
        .info-panel > .facility-view {
          display: flex;
          flex-direction: column;
          min-height: 0;
          flex: 1 1 auto;
        }
      }

      /* --- summary stat row: stays a compact, centred band on
         mobile/tablet; on desktop it's full-width within the info panel
         and pinned (see .info-panel's own note). --- */
      .summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
        max-width: 44rem;
        margin: 1.5rem auto 2.5rem;
      }
      @media (max-width: 30rem) {
        .summary { grid-template-columns: repeat(2, 1fr); }
      }
      @media (min-width: 64rem) {
        .summary {
          flex: none;
          max-width: none;
          margin: 0 0 1rem;
        }
      }
      .stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 0.75rem 0.6rem;
        text-align: center;
      }
      .stat .value {
        display: block;
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
      }
      .stat .label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35em;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        color: var(--ink-secondary);
      }
      .stat .dot {
        width: 0.55em;
        height: 0.55em;
        border-radius: 50%;
        flex: none;
      }
      .stat.available .dot, .stat.available .value { color: var(--status-good); }
      .stat.available .dot { background: var(--status-good); }
      .stat.in-use .dot { background: var(--status-in-use); }
      .stat.out-of-order .dot, .stat.out-of-order .value { color: var(--status-critical); }
      .stat.out-of-order .dot { background: var(--status-critical); }
      .stat.unknown .dot { background: var(--ink-muted); }

      /* --- Stage 7: block tabs — filters WHICH of the already-rendered
         .hall blocks below are visible, nothing else. Visually distinct
         from .facility-tabs (smaller, no pill shape) so the two tab
         rows don't read as the same control at a glance, while still
         using the same --accent active-state language as the rest of
         the app's selected/active states (e.g. the facility tab, the
         report-form's focus ring). --- */
      .block-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1rem;
        flex: none;
      }
      .block-tab {
        font: inherit;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-secondary);
        cursor: pointer;
      }
      .block-tab:hover {
        background: var(--surface-alt);
      }
      .block-tab[aria-current="true"] {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--surface);
      }
      .block-tab:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      /* Mobile/tablet: no special treatment beyond the tab row's own
         flex-wrap above — it wraps onto a second line like any other
         wrapping row, rather than needing a separate horizontal-scroll
         mobile pattern (five short labels wrap to two lines comfortably
         even at a narrow phone width). */

      /* --- zones: a Block is a location label, not another card. Flex +
         justify-content:center rather than grid so a trailing row of two
         (a 3+2 layout across five blocks) sits centred as a balanced group
         instead of stretching or reading as a "missing" third card. ---
         Stage 7: block-tabs filtering is the SAME behavior on every
         viewport (only the selected block's .hall is unhidden at a
         time) — this flex-wrap layout is what used to matter for the
         five-blocks-at-once case and is now mostly moot in practice
         (there's normally just one visible .hall), but is left as-is
         rather than special-cased, since a hidden sibling naturally
         contributes nothing to a flex/wrap layout either way. --- */
      .halls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem 1.5rem;
      }
      .hall {
        flex: 1 1 21rem;
        max-width: 24rem;
      }
      @media (max-width: 26rem) {
        .hall { flex-basis: 100%; max-width: none; }
      }
      /* Stage 6 — inside the narrow desktop info panel, a multi-column
         wrapping layout has no room to wrap into, so .halls becomes a
         single vertical column (one block per real location) and is the
         ONE element inside .info-panel that actually scrolls — summary
         above it stays fixed in place (see .info-panel's own note). */
      @media (min-width: 64rem) {
        .halls {
          flex: 1 1 auto;
          min-height: 0;
          overflow-y: auto;
          display: block;
          gap: 0;
        }
        .hall {
          max-width: none;
          margin-bottom: 1.5rem;
        }
        .hall:last-child { margin-bottom: 0; }
      }
      .zone-label {
        display: flex;
        align-items: center;
        gap: 0.4em;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-strong);
        padding-bottom: 0.5rem;
        margin-bottom: 0.75rem;
        border-bottom: 2px solid var(--border);
      }
      .zone-label svg { flex: none; }
      .machines {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      /* --- the machine card: the one actual "card" in the hierarchy --- */
      .machine {
        position: relative;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 0.8rem 0.9rem;
        box-shadow: 0 1px 2px rgba(44, 33, 21, 0.05);
      }
      .machine-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .machine-icon-chip {
        flex: none;
        width: 2.2rem;
        height: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--surface-alt);
        color: var(--accent-strong);
      }
      .machine-type {
        font-weight: 600;
        text-transform: capitalize;
        margin-right: auto;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        border-radius: 999px;
        padding: 0.2em 0.7em;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid transparent;
      }
      .status-available.badge {
        background: color-mix(in srgb, var(--status-good) 16%, var(--surface));
        color: var(--status-good);
        border-color: color-mix(in srgb, var(--status-good) 35%, transparent);
      }
      .status-in-use.badge {
        background: color-mix(in srgb, var(--status-in-use) 16%, var(--surface));
        color: var(--status-in-use);
        border-color: color-mix(in srgb, var(--status-in-use) 35%, transparent);
      }
      .status-unknown.badge {
        background: transparent;
        color: var(--ink-muted);
        border-color: var(--border);
        border-style: dashed;
      }
      /* out-of-order reads as a stamped notice, not a soft pill — same
         badge family (icon + label + shape) but solid, blocky, uppercase */
      .status-out-of-order.badge {
        background: var(--status-critical);
        color: var(--surface);
        border-color: transparent;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 800;
      }

      /* the broken-machine card also gets a hazard-tape top edge, evoking
         the physical "OUT OF ORDER" notices staff actually tape to these
         machines — fixed colours, deliberately not themed, same as the
         status palette itself */
      .machine--broken {
        border-color: color-mix(in srgb, var(--status-critical) 45%, var(--border));
      }
      .machine--broken::before {
        content: "";
        position: absolute;
        top: -1px;
        left: -1px;
        right: -1px;
        height: 8px;
        border-radius: 13px 13px 0 0;
        background: repeating-linear-gradient(
          45deg,
          var(--status-critical) 0 10px,
          var(--hazard-dark) 10px 20px
        );
      }
      .machine--broken .machine-head { margin-top: 0.15rem; }

      /* Stage 6 — clicking a machine in the 3D view scrolls its matching
         card into view here and marks it with this class (see the
         dashboard script's onHallFocusChange). Deliberately a ring, not
         a background-color swap — out-of-order's own background is
         already meaningful (the hazard gradient), so this has to read
         as "this one" without competing with or overriding any
         existing status color. Transition is brief and respects
         reduced-motion like every other animated accent in this app. */
      .machine--highlighted {
        box-shadow: 0 0 0 2px var(--accent), 0 2px 8px rgba(44, 33, 21, 0.1);
        transition: box-shadow 0.2s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        .machine--highlighted { transition: none; }
      }

      .remaining {
        margin: 0.5rem 0 0;
        font-size: 1.15rem;
        font-weight: 700;
      }
      .remaining.unknown-time {
        font-size: 0.95rem;
        font-weight: 500;
        font-style: italic;
        color: var(--ink-muted);
      }
      .confirmed {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        color: var(--ink-muted);
      }

      /* --- reporting: a small chip, clearly tappable, still secondary --- */
      details.report {
        margin-top: 0.65rem;
      }
      details.report summary {
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--accent-strong);
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        list-style: none;
        min-height: 1.6rem;
      }
      details.report summary::-webkit-details-marker { display: none; }
      details.report summary::before { content: "✎"; font-size: 0.85em; }
      details.report summary::after {
        content: "⌄";
        margin-left: 0.15em;
        transition: transform 0.15s ease;
      }
      details.report[open] summary::after { transform: rotate(180deg); }
      details.report summary:hover {
        background: color-mix(in srgb, var(--accent) 14%, var(--surface-alt));
      }
      details.report summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      form.report-form {
        margin-top: 0.5rem;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      form.report-form select,
      form.report-form input,
      form.report-form button {
        font: inherit;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.5rem 0.6rem;
        background: var(--surface);
        color: var(--ink);
      }
      form.report-form input {
        width: 9rem;
      }
      form.report-form button {
        background: var(--accent);
        color: var(--surface);
        border-color: var(--accent);
        font-weight: 600;
        cursor: pointer;
      }
      form.report-form button:hover { background: var(--accent-strong); }
      form.report-form select:focus-visible,
      form.report-form input:focus-visible,
      form.report-form button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      /* --- Stage 2 (AA Room): a facility's info-panel/hall-view-pane
         content that isn't the currently selected tab. Hidden via the
         plain `hidden` attribute, set in the template for AA Room's
         panels and toggled by the facility-tab script below.

         `!important` here is load-bearing, not belt-and-braces: a real
         browser check caught both Laundry AND AA Room rendering at once
         (Laundry's 3D canvas visibly squeezed, AA Room's placeholder and
         panel sitting underneath it) — confirmed to be a cascade bug,
         not a script bug. `.info-panel > .facility-view` and
         `.hall-view-pane > .facility-view` below (the transparent
         flex-pass-through rules) compile to TWO scoped classes plus the
         astro-cid attribute on each side of the `>`, i.e. specificity
         (0,4,0) under Astro's per-element `data-astro-cid-*` scoping —
         higher than `.facility-view[hidden]`'s own (0,3,0) (one scoped
         class + the astro-cid attribute + `[hidden]`). The pass-through
         rules' `display: flex` therefore legitimately outranked
         `[hidden]`'s `display: none` in the real cascade, independent of
         source order — confirmed by reading the actual compiled,
         minified CSS output, not assumed from the source alone.
         `!important` is the correct, standard tool for "being hidden
         must always win over this element's own internal layout rules",
         not a workaround for a specificity fight that should instead be
         won by writing a differently-shaped selector: every other way to
         outrank (0,4,0) without `!important` would mean matching or
         exceeding the pass-through rules' own selector shape, which is
         exactly as brittle the next time one of them changes. --- */
      .facility-view[hidden] {
        display: none !important;
      }

      /* AA Room's placeholder left pane — deliberately plain, not a 3D
         scene (that's later work; see
         notes/adr/0003-aa-room-live-state.md). Matches .hall-view-canvas's
         general proportions so the workbench layout doesn't jump when
         switching tabs, without pretending to be the real thing. */
      .aa-room-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--ink-muted);
        font-style: italic;
        background: var(--surface-alt);
      }

      /* --- AA Room's status line: same badge-family language as
         Laundry's STATUS_META badges (icon + label + the same
         --status-good/in-use/unknown palette), but larger and
         unbordered — it's the one and only status this panel shows, not
         one badge among many machine cards, so it reads as a headline,
         not a tag. --- */
      .aa-room-summary {
        display: block;
        margin: 0 0 1rem;
        max-width: none;
      }
      .aa-room-status {
        display: flex;
        align-items: center;
        gap: 0.5em;
        font-size: 1.3rem;
        font-weight: 700;
      }
      .aa-room-status.status-available { color: var(--status-good); }
      .aa-room-status.status-in-use { color: var(--status-in-use); }
      .aa-room-status.status-unknown { color: var(--ink-muted); }
      .aa-room-status-icon { flex: none; }
      .aa-room-activity {
        margin: 0.4rem 0 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--ink-secondary);
      }
      .aa-room-confirmed {
        display: block;
        margin-top: 0.4rem;
      }
      /* Freshness is its own line, separate from the confirmed-N-min-ago
         text — restrained (no background fill, no border, no icon
         beyond colour) per the ADR's "明显但克制地提示" instruction: a
         colour and a short sentence, not a banner. */
      .aa-room-freshness {
        margin: 0.35rem 0 0;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .aa-room-freshness.aa-freshness--stale { color: var(--warm); }
      .aa-room-freshness.aa-freshness--unknown { color: var(--ink-muted); font-style: italic; }

      .aa-room-report {
        margin-top: 0.5rem;
      }
    </style>

    {/* Stage 2's hover/focus overlay cards are created by
        src/lib/hall-view/overlay.ts via document.createElement, not
        written in this template — Astro's automatic per-component CSS
        scoping only tags elements present in the template at build
        time, so a scoped <style> rule here would silently never match
        them (confirmed: the rule compiled fine but
        getComputedStyle(...).position stayed "static", never
        "absolute", on the live card). is:global is the correct,
        deliberate choice for exactly this one case — dynamically
        created DOM — not a workaround to route around scoping
        elsewhere in this file. The one deliberate "cyber/HUD" accent
        in the app — cyan/electric, monospace, small glowing borders —
        kept confined to these two elements and the in-scene
        outline/brackets they echo, never bleeding into the dashboard's
        own warm, soft-edged visual language below. Restrained on
        purpose: a thin glow and a little structure, not a packed
        sci-fi console. */}
    <style is:global>
      .hall-hover-card {
        position: absolute;
        z-index: 2;
        pointer-events: none; /* never intercepts the canvas's own pointer events */
        min-width: 9rem;
        padding: 0.5rem 0.7rem;
        border-radius: 8px;
        background: rgba(28, 21, 15, 0.82);
        border: 1px solid rgba(95, 232, 224, 0.45);
        box-shadow: 0 0 12px rgba(95, 232, 224, 0.25);
        color: #eafffd;
        font-size: 0.78rem;
        line-height: 1.4;
      }
      .hall-hover-card__room {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9fd8d3;
      }
      .hall-hover-card__name {
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      .hall-hover-card__meta {
        color: #9fd8d3;
        font-size: 0.72rem;
      }
      .hall-status--available { color: #6fe08a; }
      .hall-status--in-use { color: #6fc6ff; }
      .hall-status--out-of-order { color: #ff8a8a; }
      .hall-status--unknown { color: #a8a0ff; opacity: 0.75; }

      /* Stage 2.2: left/top are computed entirely in JS
         (overlay.ts's positionFocusPanel) as the panel's literal
         top-left corner in container-space pixels, already accounting
         for the stem's length and clamped to stay fully on-screen — no
         CSS transform is applied (overlay.ts explicitly sets
         `transform: none`), so there's nothing here for a transform to
         conflict with. --hall-stem-length is set once from JS, in real
         pixels, and read by both overlay.ts's clamp math and the
         ::after stem below, so the two can never drift out of sync the
         way a separately-guessed CSS px value could. */
      .hall-focus-panel {
        --hall-stem-length: 10px;
        position: absolute;
        z-index: 3;
        width: 11.5rem;
        color: #eafffd;
        font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      }
      /* The connecting "stem" — a short vertical line from the panel's
         bottom edge down to the anchor point, making the two visually
         one instrument rather than two unrelated floating pieces. Stays
         on the outer (unanimated) element, not the inner reveal wrapper
         below — the stem is positioning/framing, not part of the
         fade/slide-in content, so it shouldn't animate in sync with it. */
      .hall-focus-panel::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: calc(-1 * var(--hall-stem-length));
        width: 1px;
        height: var(--hall-stem-length);
        background: rgba(95, 232, 224, 0.6);
      }
      /* Stage 4 — the actual visual chrome (background/border/glow/
         padding) lives here, on the inner reveal wrapper, so its opacity
         and transform can animate as one unit without the stem (which
         stays on the outer element, unanimated) moving with it. Default
         state is the "revealed" end state — JS adds
         --revealed only after one animation frame (see overlay.ts's own
         note on why), and the *absence* of that class plus this
         transition is what makes the reveal/hide animate instead of
         snap; a browser with JS disabled would simply never run
         overlay.ts at all, so this is not a progressive-enhancement
         concern. */
      .hall-focus-panel__inner {
        padding: 0.7rem 0.8rem 0.6rem;
        border-radius: 10px;
        background: rgba(20, 16, 12, 0.88);
        border: 1px solid rgba(95, 232, 224, 0.55);
        box-shadow: 0 0 18px rgba(95, 232, 224, 0.3);
        opacity: 0;
        transform: translateY(-0.3rem) scaleY(0.94);
        transform-origin: top center;
        transition:
          opacity var(--hall-focus-reveal-seconds, 0.2s) ease,
          transform var(--hall-focus-reveal-seconds, 0.2s) ease;
      }
      .hall-focus-panel__inner--revealed {
        opacity: 1;
        transform: translateY(0) scaleY(1);
      }
      /* prefers-reduced-motion: the brief requires an instant final
         state with no animated frames at all — not just a shorter
         transition. transition: none means even the very first "add the
         --revealed class" frame renders already-final, with nothing in
         between to animate. */
      @media (prefers-reduced-motion: reduce) {
        .hall-focus-panel__inner {
          transition: none;
        }
      }
      .hall-focus-panel__close {
        position: absolute;
        top: 0.4rem;
        right: 0.5rem;
        background: none;
        border: none;
        color: #9fd8d3;
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
        padding: 0.1rem 0.3rem;
      }
      .hall-focus-panel__close:hover { color: #eafffd; }
      .hall-focus-panel__header {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        margin-bottom: 0.5rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid rgba(95, 232, 224, 0.3);
      }
      .hall-focus-panel__room {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9fd8d3;
      }
      .hall-focus-panel__name {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .hall-focus-panel__status {
        font-size: 0.72rem;
        font-weight: 600;
      }
      .hall-focus-panel__facts {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.2rem 0.5rem;
        margin: 0;
        font-size: 0.72rem;
      }
      .hall-focus-panel__facts dt {
        color: #9fd8d3;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-size: 0.65rem;
      }
      .hall-focus-panel__facts dd {
        margin: 0;
        text-align: right;
      }
    </style>
  </head>
  <body data-status-meta={JSON.stringify(STATUS_META)}>
    <main>
      <header class="hero">
        <h1>Toad Live</h1>
        <p>
          Shared spaces across Toad Hall — reported by residents, not
          sensors. See <a href="/readme/">what "good" means here</a>.
        </p>
        <p class="identity">You're reporting as <strong>{pseudonym}</strong></p>
      </header>

      {/* Stage 6 — facility tabs. Toad Live's original concept was every
          shared space in the Hall, not laundry specifically; Laundry is
          the only tab backed by real data today. The other six are
          plain disabled buttons — visible so the app's intended shape is
          legible, inert so nothing here implies a working page or
          invented data behind them. aria-current="page" on the one real
          tab, not a class alone, so assistive tech gets the same signal
          sighted users get from its filled-in style. */}
      {/* Stage 2 (AA Room) — Laundry and AA Room are now both real,
          clickable tabs; the other five stay exactly as they were
          (plain disabled buttons, no route, no invented data). Each
          clickable tab carries data-facility, read by the script below
          to show/hide that facility's hall-view-pane and info-panel
          content — nothing here duplicates machine or AA Room data, it
          only ever toggles which already-rendered panel is visible. */}
      <nav class="facility-tabs" aria-label="Shared spaces">
        <button type="button" class="facility-tab" data-facility="laundry" aria-current="page">Laundry</button>
        <button type="button" class="facility-tab" data-facility="aa-room">AA Room</button>
        <button type="button" class="facility-tab" disabled>Otter Room</button>
        <button type="button" class="facility-tab" disabled>Rabbit Room</button>
        <button type="button" class="facility-tab" disabled>Badger Room</button>
        <button type="button" class="facility-tab" disabled>Rat Room</button>
        <button type="button" class="facility-tab" disabled>Weasel Room</button>
      </nav>

      {/* Stage 6 — the 70/30 desktop workbench: hall-view-pane (left) and
          info-panel (right) below are a pure CSS reshaping of exactly
          the same two sections this page already had — the hall-view
          <section> and the summary/halls <section>s are UNCHANGED
          markup, just re-parented into this grid (see index.astro's own
          CSS notes on .workbench/.hall-view-pane/.info-panel). Below
          64rem this grid collapses and these wrapper divs have no
          layout effect at all, so mobile/tablet renders source-order
          identically to how the page always has. */}
      <div class="workbench">
        <div class="hall-view-pane">
          {/* Live Hall View — Stage 3: all five real laundry rooms, a visual
              layer above the dashboard, never a replacement for it.
              aria-hidden because every fact it shows is already stated as
              accessible text below; a screen-reader user loses nothing by
              this section being skipped entirely. Initialized once from
              this page load's real state via data-machines, then kept live
              by the dashboard script's existing applyMachineUpdate() below
              (see scene.ts's applyMachineToScene note).

              Stage 2 (AA Room) — wrapped in data-facility="laundry" so the
              facility-tab script can hide it when AA Room is selected;
              nothing inside this wrapper changes. */}
          <div class="facility-view" data-facility="laundry">
            <section
              class="hall-view"
              aria-hidden="true"
              data-machines={JSON.stringify(hallViewMachines)}
            >
              <div class="hall-view-canvas" id="hall-view-canvas"></div>
              <p class="hall-view-caption">Toad Hall — live laundry miniature</p>
            </section>
          </div>

          {/* AA Room's left pane for this stage: a plain placeholder, not a
              3D scene — that's explicitly later work (see
              notes/adr/0003-aa-room-live-state.md's own "what this ADR
              does not decide"). Hidden by default; the facility-tab
              script below shows it only when AA Room is selected. */}
          <div class="facility-view" data-facility="aa-room" hidden>
            <section class="hall-view aa-room-placeholder" aria-hidden="true">
              <p>AA Room visual coming next.</p>
            </section>
          </div>
        </div>

        <div class="info-panel">
      <div class="facility-view" data-facility="laundry">
      <section class="summary" aria-label="Laundry summary">
        {summary.map(({ key, count }) => (
          <div class:list={["stat", key]}>
            <span class="value">{count}</span>
            <span class="label"><span class="dot"></span>{STATUS_META[key].label.toLowerCase()}</span>
          </div>
        ))}
      </section>

      {/* Stage 7 — block tabs: a pure VIEW filter over this same markup,
          not a second machine list. Each .hall keeps data-location so
          the dashboard script below can show/hide whole <article>s by
          toggling [hidden] — no machine, status, or summary data is
          read, duplicated, or recomputed by that script; it only ever
          flips which of these already-rendered blocks the browser
          paints. Mirrors the facility-tabs' own aria-current="page"
          pattern for the active indicator. */}
      <nav class="block-tabs" aria-label="Filter by block">
        {LOCATIONS.map((location, index) => (
          <button
            type="button"
            class="block-tab"
            data-location={location}
            aria-current={index === 0 ? "true" : undefined}
          >
            {location}
          </button>
        ))}
      </nav>

      <section class="halls">
        {LOCATIONS.map((location, index) => (
          <article class="hall" data-location={location} hidden={index !== 0}>
            <h2 class="zone-label">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-6.5-5.8-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.2-6.5 11-6.5 11z" />
                <circle cx="12" cy="10" r="2.2" />
              </svg>
              Block {location}
            </h2>
            <div class="machines">
              {byLocation.get(location)!.map((machine) => {
                const meta = STATUS_META[machine.status];
                const remaining = machine.status === "in-use" ? remainingLabel(machine) : null;
                const broken = machine.status === "out-of-order";
                return (
                  <div
                    class:list={["machine", broken && "machine--broken"]}
                    data-machine={machine.id}
                    data-status={machine.status}
                  >
                    <div class="machine-head">
                      <span class="machine-icon-chip" aria-hidden="true">
                        {machine.type === "washer" ? (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="2.5" width="18" height="19" rx="3" />
                            <circle cx="12" cy="13" r="6" />
                            <path d="M9 13c.8-1 1.5-1 2 0s1.2 1 2 0" />
                            <circle cx="6.5" cy="5.5" r="0.6" fill="currentColor" stroke="none" />
                            <circle cx="9" cy="5.5" r="0.6" fill="currentColor" stroke="none" />
                          </svg>
                        ) : (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="2.5" width="18" height="19" rx="3" />
                            <circle cx="12" cy="13" r="6" />
                            <path d="M9.5 15.3a3.2 3.2 0 0 1 4.6-4" />
                            <path d="M14.5 10.7a3.2 3.2 0 0 1-4.6 4" />
                            <line x1="6.5" y1="5.5" x2="9" y2="5.5" />
                          </svg>
                        )}
                      </span>
                      <span class="machine-type">{machine.type}</span>
                      <span class:list={["badge", meta.class]}>
                        <span aria-hidden="true">{meta.icon}</span>{meta.label}
                      </span>
                    </div>

                    {/* Always rendered, hidden when not in-use, so a live
                        update has a stable node to toggle rather than
                        needing to build this element from scratch in JS. */}
                    <p
                      class:list={["remaining", remaining && !remaining.known && "unknown-time"]}
                      hidden={!remaining}
                    >
                      {remaining ? remaining.text : ""}
                    </p>
                    <span class="confirmed">{confirmedLabel(machine.confirmedAt)}</span>

                    <details class="report">
                      <summary>Update status</summary>
                      <form class="report-form" data-id={machine.id} data-version={machine.version}>
                        <select name="status" aria-label={`New status for ${location} ${machine.type}`}>
                          <option value="available">Available</option>
                          <option value="in-use">In use</option>
                          <option value="out-of-order">Out of order</option>
                        </select>
                        <input
                          type="number"
                          name="minutes"
                          min="0"
                          placeholder="minutes left (optional)"
                          aria-label="Minutes remaining, optional"
                        />
                        <button type="submit">Report</button>
                      </form>
                    </details>
                  </div>
                );
              })}
            </div>
          </article>
        ))}
      </section>
      </div>

      {/* AA Room's practical panel — Stage 2: reads from the canonical
          /api/aa-room state passed down via data-aa-room (the same
          "initial render from this page load's real state, then kept
          live by its own script" shape the Laundry panel already uses
          for `machines`). Hidden by default, shown only when the AA Room
          facility tab is selected. No block-tabs: AA Room is one room,
          not five locations. */}
      <div class="facility-view aa-room-panel" data-facility="aa-room" hidden data-aa-room={JSON.stringify(aaRoom)}>
        <section class="summary aa-room-summary" aria-label="AA Room status">
          <div class:list={["aa-room-status", AA_ROOM_STATUS_META[aaRoom.occupancy].class]}>
            <span class="aa-room-status-icon" aria-hidden="true">{AA_ROOM_STATUS_META[aaRoom.occupancy].icon}</span>
            <span class="aa-room-status-label">{AA_ROOM_STATUS_META[aaRoom.occupancy].label}</span>
          </div>
          {/* Always rendered, hidden when there's no activity to show — same
              "stable node, toggled, never built from scratch" shape as
              Laundry's .remaining paragraph. Never a hardcoded fallback
              label when activity is unset (ADR 0003: unset activity means
              "nothing specific to report," not a value to invent a label
              for). */}
          <p class="aa-room-activity" hidden={!aaRoom.activity}>
            {aaRoom.activity ? AA_ROOM_ACTIVITY_META[aaRoom.activity].label : ""}
          </p>
          <span class="confirmed aa-room-confirmed">{aaRoomConfirmedLabel(aaRoom.confirmedAt)}</span>
          {(() => {
            const fresh = aaRoomFreshnessLabel(aaRoom.freshness);
            return (
              <p class:list={["aa-room-freshness", fresh?.class]} hidden={!fresh}>
                {fresh?.text ?? ""}
              </p>
            );
          })()}
        </section>

        <details class="report aa-room-report">
          <summary>Update status</summary>
          {/* Only empty/occupied are ever offered — unknown is never a
              reportable value (ADR 0003, Decision 2): it's what seeding or
              decay produces, never something a resident observes and
              reports. data-version is kept in sync with every canonical
              state this panel receives, the same way Laundry's
              .report-form does. */}
          <form class="report-form aa-room-report-form" data-version={aaRoom.version}>
            <select name="occupancy" aria-label="AA Room status">
              <option value="empty">Empty</option>
              <option value="occupied">Occupied</option>
            </select>
            {/* Hidden whenever occupancy isn't "occupied" — the report
                script below clears its value AND hides it together, so an
                empty report can never carry a stale activity selection
                left over from a previous occupied one. */}
            <select name="activity" aria-label="What's happening (optional)" class="aa-room-activity-select" hidden>
              <option value="">Unspecified</option>
              <option value="tv">TV</option>
              <option value="pool">Pool</option>
              <option value="table-tennis">Table tennis</option>
              <option value="event">Event</option>
            </select>
            <button type="submit">Report</button>
          </form>
        </details>
      </div>
        </div>
      </div>
    </main>

    {/* Live Hall View mount — its own inline script block, still
        touching only the hall-view-canvas element, never the dashboard
        markup. Stage 2.3: the dashboard's own script (next) now imports
        applyMachineToScene from this same scene.ts module to feed it
        live updates — see that import's own note on how two separate
        inline script blocks share one module instance. Nothing here
        changes: this block still only mounts the scene from the
        page's initial state; it's the *other* script that reaches
        into this module now, not this one reaching out. */}
    {/* Stage 2 (AA Room) — facility-tab switching: a pure VIEW filter,
        the same "toggle [hidden] on already-rendered content, read/write
        no machine or AA Room data" shape as the block-tabs script below.
        Its own, separate inline script block — not a literal tag written
        out in this comment, since a naive scanner can mistake that for a
        real script boundary — independent of the two that follow, since
        it owns none of their state and neither of them needs to know
        this one exists. */}
    <script>
      const facilityTabs = document.querySelectorAll<HTMLButtonElement>(".facility-tab[data-facility]");
      const facilityViews = document.querySelectorAll<HTMLElement>(".facility-view[data-facility]");

      function selectFacility(facility: string): void {
        for (const view of facilityViews) {
          view.hidden = view.dataset.facility !== facility;
        }
        for (const tab of facilityTabs) {
          if (tab.dataset.facility === facility) tab.setAttribute("aria-current", "page");
          else tab.removeAttribute("aria-current");
        }
      }

      facilityTabs.forEach((tab) => {
        tab.addEventListener("click", () => selectFacility(tab.dataset.facility!));
      });
    </script>

    <script>
      import { mount } from "../lib/hall-view/scene.ts";
      import type { Machine } from "../lib/types.ts";

      // Stage 7 — block tabs: a pure VIEW filter over the existing
      // .hall markup (see that <nav>'s own template-side note). This
      // reads/writes only DOM attributes already rendered server-side —
      // no machine or status data is read here, so this can live
      // entirely alongside the mount() call below rather than needing
      // any bridge to the second script block's applyMachineUpdate()
      // (which remains the only machine-data writer, untouched).
      const blockTabs = document.querySelectorAll<HTMLButtonElement>(".block-tab");
      const hallsByLocation = new Map<string, HTMLElement>(
        Array.from(document.querySelectorAll<HTMLElement>(".hall")).map((hall) => [
          hall.dataset.location!,
          hall,
        ]),
      );

      function selectBlock(location: string): void {
        for (const [loc, hall] of hallsByLocation) hall.hidden = loc !== location;
        for (const tab of blockTabs) {
          if (tab.dataset.location === location) tab.setAttribute("aria-current", "true");
          else tab.removeAttribute("aria-current");
        }
      }

      blockTabs.forEach((tab) => {
        tab.addEventListener("click", () => selectBlock(tab.dataset.location!));
      });

      const container = document.getElementById("hall-view-canvas");
      const section = document.querySelector<HTMLElement>(".hall-view");
      if (container && section) {
        try {
          const machines = JSON.parse(section.dataset.machines!) as Machine[];
          // Stage 6 — the only new behavior mount() is given here: when
          // a machine is focused/unfocused in the 3D view, scroll its
          // matching info-panel card into view and mark it highlighted.
          // Deliberately NOT opening its <details class="report"> —
          // focusing a machine is "look at this one," not "I'm about to
          // report its status," so the report control stays collapsed
          // until the resident explicitly opens it themselves.
          //
          // Stage 7 — also switches the right panel's block tab to the
          // focused machine's own block first, so its card is actually
          // visible (not hidden by a different block's filter) before
          // scrolling/highlighting it. On return to overview
          // (machineId === null), the current block tab is deliberately
          // left as-is — the brief's own "focus exiting can leave the
          // current Block tab unchanged" requirement — only the
          // highlight is cleared.
          const prefersReducedMotion =
            window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
          let highlightedCard: HTMLElement | null = null;
          mount(container, machines, (machineId) => {
            highlightedCard?.classList.remove("machine--highlighted");
            highlightedCard = null;
            if (!machineId) return;
            const card = document.querySelector<HTMLElement>(`.machine[data-machine="${machineId}"]`);
            if (!card) return;
            const hall = card.closest<HTMLElement>(".hall");
            if (hall?.dataset.location) selectBlock(hall.dataset.location);
            card.classList.add("machine--highlighted");
            highlightedCard = card;
            card.scrollIntoView({ block: "nearest", behavior: prefersReducedMotion ? "auto" : "smooth" });
          });
        } catch {
          // WebGL unavailable, or anything else went wrong building the
          // scene — the dashboard above and below is a complete
          // experience on its own either way, so this fails silently
          // rather than showing a broken canvas. See Stage 4 in the
          // design notes for a more deliberate fallback treatment.
          container.remove();
          section.querySelector(".hall-view-caption")?.remove();
        }
      }
    </script>

    <script>
      // Stage 2.3: the 3D hall view's only hook into live updates — see
      // scene.ts's own note on why importing this here, from a second,
      // separate inline script block, still reaches the same module
      // instance mount() runs in (ES modules are singletons keyed by
      // URL; both scripts import the same file).
      import { applyMachineToScene } from "../lib/hall-view/scene.ts";
      import type { Machine } from "../lib/types.ts";
      // Stage 3 (AA Room): the page's one SSE connection now lives in its
      // own shared module (src/lib/live-stream.ts) rather than as a local
      // `const events` here, specifically so the separate AA Room script
      // block further down can observe `aa-room` events on the exact same
      // connection instead of opening a second EventSource. See that
      // module's own note on why — same "ES modules are singletons keyed
      // by URL" sharing scene.ts already relies on.
      import { onMachineEvent, onOpen } from "../lib/live-stream.ts";

      // Server-rendered badge text/icon/class (STATUS_META in the
      // frontmatter above), read once rather than re-derived here, so a
      // live update can never drift from what a fresh page load would show.
      const STATUS_META = JSON.parse(document.body.dataset.statusMeta!) as Record<
        string,
        { label: string; icon: string; class: string }
      >;

      // The server's actual GET/PATCH/SSE payloads are the full Machine
      // shape (src/lib/types.ts) — this was previously its own narrower
      // local interface (id/status/expectedEndAt/confirmedAt/version
      // only, with status typed as a loose string) that happened to
      // cover what the dashboard card needed. Widened to the real
      // Machine type so the exact same payload can also be handed to
      // applyMachineToScene() below without a cast or a second parse.
      type MachineUpdate = Machine;

      // Mirrors confirmedLabel()/remainingLabel() in the frontmatter above.
      // Both need the *client's* current clock, so they can't be shared
      // directly across the server/client boundary — kept tiny and
      // behaviourally identical instead of invented differently here.
      function confirmedLabel(confirmedAt: number | null): string {
        if (confirmedAt === null) return "never reported";
        const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
        if (minutes < 1) return "confirmed just now";
        return `confirmed ${minutes} min ago`;
      }

      function remainingLabel(expectedEndAt: number | null): { text: string; known: boolean } {
        if (expectedEndAt === null) return { text: "remaining time unknown", known: false };
        const minutes = Math.round((expectedEndAt - Date.now()) / 60_000);
        return minutes > 0
          ? { text: `${minutes} min left`, known: true }
          : { text: "should be finishing", known: true };
      }

      // One status per visible machine, kept in sync with every incoming
      // update so the summary row never needs a full-page recount.
      const statusByMachine = new Map<string, string>(
        Array.from(document.querySelectorAll<HTMLElement>(".machine")).map((el) => [
          el.dataset.machine!,
          el.dataset.status!,
        ]),
      );

      function updateSummary(): void {
        const counts: Record<string, number> = { available: 0, "in-use": 0, "out-of-order": 0, unknown: 0 };
        for (const status of statusByMachine.values()) counts[status] = (counts[status] ?? 0) + 1;
        for (const [key, count] of Object.entries(counts)) {
          const el = document.querySelector(`.stat.${key} .value`);
          if (el) el.textContent = String(count);
        }
      }

      // Applies one machine's canonical state to its card — used for a
      // live push, for the current state a 409 conflict hands back, and
      // for the re-fetch a (re)connected EventSource triggers below. Never
      // reloads the page: this *is* "without a reload."
      //
      // Stage 2.3: also the Hall View's only subscriber to this same
      // canonical path (see applyMachineToScene's own note in scene.ts).
      // Called unconditionally, before the dashboard-card early return
      // below, since it's an orthogonal concern: applyMachineToScene()
      // already no-ops for any machine id it has no mesh for (today,
      // anything outside the A/B room), the same way this function's
      // own card lookup no-ops for an id it finds no card for.
      function applyMachineUpdate(machine: MachineUpdate): void {
        applyMachineToScene(machine);

        const card = document.querySelector<HTMLElement>(`.machine[data-machine="${machine.id}"]`);
        if (!card) return;

        card.dataset.status = machine.status;
        card.classList.toggle("machine--broken", machine.status === "out-of-order");

        const meta = STATUS_META[machine.status];
        const badge = card.querySelector(".badge");
        if (badge && meta) {
          badge.className = `badge ${meta.class}`;
          badge.innerHTML = `<span aria-hidden="true">${meta.icon}</span>${meta.label}`;
        }

        const remainingEl = card.querySelector<HTMLElement>(".remaining");
        if (remainingEl) {
          if (machine.status === "in-use") {
            const remaining = remainingLabel(machine.expectedEndAt);
            remainingEl.hidden = false;
            remainingEl.classList.toggle("unknown-time", !remaining.known);
            remainingEl.textContent = remaining.text;
          } else {
            remainingEl.hidden = true;
          }
        }

        const confirmedEl = card.querySelector(".confirmed");
        if (confirmedEl) confirmedEl.textContent = confirmedLabel(machine.confirmedAt);

        // The next PATCH from this card must match the version it just
        // saw, not the one the page was originally rendered with.
        const form = card.querySelector<HTMLFormElement>(".report-form");
        if (form) form.dataset.version = String(machine.version);

        statusByMachine.set(machine.id, machine.status);
        updateSummary();
      }

      // The page's one SSE connection (src/lib/live-stream.ts). No event
      // replay/history: a (re)connection just re-fetches current state
      // for every card below, the same read path any page load already
      // uses — see notes/adr/0001-realtime-and-concurrent-updates.md.
      onMachineEvent((machine) => {
        applyMachineUpdate(machine);
      });

      onOpen(() => {
        const ids = Array.from(document.querySelectorAll<HTMLElement>(".machine")).map(
          (el) => el.dataset.machine!,
        );
        Promise.all(
          ids.map((id) => fetch(`/api/machines/${id}`).then((res) => res.json() as Promise<MachineUpdate>)),
        ).then((machines) => machines.forEach(applyMachineUpdate));
      });

      document.querySelectorAll<HTMLFormElement>(".report-form").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const id = form.dataset.id;
          const ifVersion = Number(form.dataset.version);
          const status = (form.elements.namedItem("status") as HTMLSelectElement).value;
          const minutesRaw = (form.elements.namedItem("minutes") as HTMLInputElement).value;
          const minutes = minutesRaw === "" ? null : Number(minutesRaw);

          // No reporterId here — the actor is resolved server-side from
          // this browser's session cookie (see
          // notes/adr/0002-identity-and-permissions.md); the cookie is
          // sent automatically with same-origin fetch, nothing to attach
          // client-side.
          const res = await fetch(`/api/machines/${id}`, {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              status,
              ifVersion,
              expectedEndAt:
                status === "in-use" && minutes !== null ? Date.now() + minutes * 60_000 : undefined,
            }),
          });

          if (res.ok) {
            // This session's own open SSE connection receives the same
            // broadcast every other open session does, so the card updates
            // itself the normal way — nothing left to do but tidy the form.
            const details = form.closest("details.report");
            if (details) (details as HTMLDetailsElement).open = false;
            return;
          }

          if (res.status === 409) {
            // Someone else's report, or a lazy decay, landed since this
            // card was rendered. Say so plainly, show the state the server
            // actually holds, and let the resident decide whether to
            // report again — never a silent overwrite and never a silent
            // reload either.
            const { current } = await res.json();
            applyMachineUpdate(current);
            const label = STATUS_META[current.status]?.label ?? current.status;
            alert(
              `This machine changed since you last saw it — it's now reported as "${label}". ` +
                "The card shows that now; check it and report again if it's still wrong.",
            );
            return;
          }

          alert("couldn't save that report — try again");
        });
      });
    </script>

    {/* Stage 2 (AA Room) — its own, separate state and script, not folded
        into the Laundry dashboard's applyMachineUpdate(): AA Room's
        canonical shape (AaRoomState) is deliberately not the Machine
        shape (see notes/adr/0003-aa-room-live-state.md), so this is its
        own small "render canonical state into these DOM nodes" function,
        the AA Room equivalent of applyMachineUpdate() above, not a reuse
        of it. Stage 3 wires this into the page's one shared SSE
        connection (src/lib/live-stream.ts) below — same connection
        Laundry's own script observes, no second EventSource. */}
    <script>
      import { onAaRoomEvent, onOpen } from "../lib/live-stream.ts";

      type AaRoomOccupancy = "empty" | "occupied" | "unknown";
      type AaRoomActivity = "tv" | "pool" | "table-tennis" | "event";
      interface AaRoomState {
        occupancy: AaRoomOccupancy;
        activity: AaRoomActivity | null;
        confirmedAt: number | null;
        version: number;
        freshness: "fresh" | "stale" | null;
      }

      const STATUS_META: Record<AaRoomOccupancy, { label: string; icon: string; class: string }> = {
        empty: { label: "Empty", icon: "✓", class: "status-available" },
        occupied: { label: "Occupied", icon: "●", class: "status-in-use" },
        unknown: { label: "Unknown", icon: "?", class: "status-unknown" },
      };
      const ACTIVITY_META: Record<AaRoomActivity, { label: string }> = {
        tv: { label: "TV" },
        pool: { label: "Pool" },
        "table-tennis": { label: "Table tennis" },
        event: { label: "Event" },
      };

      // Mirrors confirmedLabel()/remainingLabel() elsewhere on this page —
      // both need the client's current clock, so neither can be shared
      // directly across the server/client boundary; kept tiny and
      // behaviourally identical instead of invented differently here.
      function confirmedLabel(confirmedAt: number | null): string {
        if (confirmedAt === null) return "never reported";
        const minutes = Math.round((Date.now() - confirmedAt) / 60_000);
        if (minutes < 1) return "confirmed just now";
        return `confirmed ${minutes} min ago`;
      }

      function freshnessLabel(freshness: AaRoomState["freshness"]): { text: string; cls: string } | null {
        if (freshness === "fresh") return null;
        if (freshness === "stale") return { text: "this may be out of date", cls: "aa-freshness--stale" };
        return { text: "no recent enough report to show", cls: "aa-freshness--unknown" };
      }

      const panel = document.querySelector<HTMLElement>(".aa-room-panel");
      const statusEl = panel?.querySelector<HTMLElement>(".aa-room-status");
      const statusIconEl = panel?.querySelector<HTMLElement>(".aa-room-status-icon");
      const statusLabelEl = panel?.querySelector<HTMLElement>(".aa-room-status-label");
      const activityEl = panel?.querySelector<HTMLElement>(".aa-room-activity");
      const confirmedEl = panel?.querySelector<HTMLElement>(".aa-room-confirmed");
      const freshnessEl = panel?.querySelector<HTMLElement>(".aa-room-freshness");
      const form = panel?.querySelector<HTMLFormElement>(".aa-room-report-form");
      const occupancySelect = form?.elements.namedItem("occupancy") as HTMLSelectElement | null;
      const activitySelect = form?.querySelector<HTMLSelectElement>(".aa-room-activity-select");

      // Applies AA Room's canonical state to the panel — used for the
      // initial server-rendered state (called once below), and again for
      // whatever this browser's own PATCH response hands back (success or
      // 409 conflict alike). Never reached by any other session's report
      // yet — that's Stage 3's SSE wiring.
      function applyAaRoomUpdate(room: AaRoomState): void {
        if (!statusEl || !statusIconEl || !statusLabelEl || !activityEl || !confirmedEl || !freshnessEl || !form) {
          return;
        }

        const meta = STATUS_META[room.occupancy];
        statusEl.className = `aa-room-status ${meta.class}`;
        statusIconEl.textContent = meta.icon;
        statusLabelEl.textContent = meta.label;

        if (room.activity) {
          activityEl.hidden = false;
          activityEl.textContent = ACTIVITY_META[room.activity].label;
        } else {
          activityEl.hidden = true;
          activityEl.textContent = "";
        }

        confirmedEl.textContent = confirmedLabel(room.confirmedAt);

        const fresh = freshnessLabel(room.freshness);
        if (fresh) {
          freshnessEl.hidden = false;
          freshnessEl.className = `aa-room-freshness ${fresh.cls}`;
          freshnessEl.textContent = fresh.text;
        } else {
          freshnessEl.hidden = true;
          freshnessEl.textContent = "";
        }

        form.dataset.version = String(room.version);
      }

      // Keeps the activity <select> in sync with the occupancy <select> —
      // shown and usable only when "Occupied" is chosen; hidden AND reset
      // to "Unspecified" together whenever it isn't, so an "Empty" report
      // can never silently carry a leftover activity value the resident
      // never saw or chose for this submission (see the ADR, Decision 1:
      // activity only ever means anything alongside "occupied").
      function syncActivityVisibility(): void {
        if (!occupancySelect || !activitySelect) return;
        const showActivity = occupancySelect.value === "occupied";
        activitySelect.hidden = !showActivity;
        if (!showActivity) activitySelect.value = "";
      }

      if (panel) {
        const initial = JSON.parse(panel.dataset.aaRoom!) as AaRoomState;
        applyAaRoomUpdate(initial);

        occupancySelect?.addEventListener("change", syncActivityVisibility);
        syncActivityVisibility();

        // Stage 3 — a push from ANY session's report or decay transition,
        // over the page's one shared SSE connection. applyAaRoomUpdate()
        // only ever writes the display elements (status/activity-label/
        // confirmed/freshness/version) and never touches
        // occupancySelect.value or activitySelect.value, so a resident
        // mid-way through choosing their own report is never overwritten
        // by someone else's — the same property Laundry's own
        // applyMachineUpdate() already has for its report form, not a new
        // rule invented here. Deliberately NOT calling
        // syncActivityVisibility() here: that function reacts to this
        // browser's own occupancySelect value, which an incoming push
        // never changes, so there's nothing for it to resync.
        onAaRoomEvent((room) => {
          applyAaRoomUpdate(room);
        });

        // Stage 3 — (re)connect re-fetches current AA Room state, the
        // same "a (re)connection's own read is itself a qualifying read"
        // principle the Laundry dashboard's onOpen() above already
        // relies on.
        onOpen(() => {
          fetch("/api/aa-room")
            .then((res) => res.json() as Promise<AaRoomState>)
            .then(applyAaRoomUpdate);
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const occupancy = occupancySelect!.value;
          const activityRaw = activitySelect!.hidden ? "" : activitySelect!.value;
          const ifVersion = Number(form!.dataset.version);

          // No reporterId here, same as Laundry's own report script — the
          // actor is resolved server-side from this browser's session
          // cookie (notes/adr/0002-identity-and-permissions.md).
          const res = await fetch("/api/aa-room", {
            method: "PATCH",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              occupancy,
              activity: activityRaw === "" ? null : activityRaw,
              ifVersion,
            }),
          });

          if (res.ok) {
            const room = (await res.json()) as AaRoomState;
            applyAaRoomUpdate(room);
            syncActivityVisibility();
            const details = form!.closest("details.report");
            if (details) (details as HTMLDetailsElement).open = false;
            return;
          }

          if (res.status === 409) {
            // Same conflict UX as Laundry's own report script: say so
            // plainly, show the state the server actually holds, let the
            // resident decide whether to report again — never a silent
            // overwrite, never a silent reload.
            const { current } = await res.json();
            applyAaRoomUpdate(current as AaRoomState);
            syncActivityVisibility();
            const label = STATUS_META[(current as AaRoomState).occupancy]?.label ?? (current as AaRoomState).occupancy;
            alert(
              `AA Room changed since you last saw it — it's now reported as "${label}". ` +
                "The panel shows that now; check it and report again if it's still wrong.",
            );
            return;
          }

          alert("couldn't save that report — try again");
        });
      }
    </script>
  </body>
</html>
